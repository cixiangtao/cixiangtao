---
import MacWindow from './MacWindow.astro';
import { getMessages, type Locale } from '../i18n';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const copy = getMessages(locale);
---

<MacWindow
	title={copy.about.title}
	icon="profile"
	id="about"
	closeLabel={copy.window.close(copy.about.title)}
	class="order-1 lg:absolute lg:left-[12%] lg:top-[7%] lg:z-20 lg:w-[34%]"
>
	<div class="about-panel grid grid-cols-[88px_minmax(0,1fr)] items-center gap-[18px] p-[22px] max-[760px]:grid-cols-[72px_minmax(0,1fr)] max-[760px]:p-[17px]">
		<a class="pixel-avatar" href="https://github.com/cixiangtao" target="_blank" rel="noreferrer" aria-label={copy.about.openProfile}>
			<img src="https://github.com/cixiangtao.png?size=176" alt={copy.about.avatarAlt} width="176" height="176" decoding="async" fetchpriority="high" />
		</a>
		<div class="min-w-0">
			<h1>cixiangtao</h1>
			<p class="about-role">{copy.about.role}</p>
			<p class="about-copy">{copy.about.copy}</p>
		</div>
	</div>
	<div class="about-status flex items-center justify-between border-t border-[var(--ink)] bg-[var(--paper)] px-4 py-[9px] text-[0.72rem] font-[750] max-[760px]:gap-2.5">
		<nav class="about-shortcuts inline-flex items-center gap-3.5" aria-label={copy.about.publicLinks}>
			<a href="https://github.com/cixiangtao" target="_blank" rel="noreferrer" aria-label="GitHub"><i class="shortcut-icon shortcut-icon--github" aria-hidden="true"></i></a>
			<span class="h-5 w-px bg-[var(--line-strong)]" aria-hidden="true"></span>
			<a href="#projects" aria-label={copy.about.projects}><i class="shortcut-icon shortcut-icon--folder" aria-hidden="true"></i></a>
			<span class="h-5 w-px bg-[var(--line-strong)]" aria-hidden="true"></span>
			<a href="#writing" aria-label={copy.about.writing}><i class="shortcut-icon shortcut-icon--mail" aria-hidden="true"></i></a>
		</nav>
		<span class="inline-flex items-center gap-[7px]"><i class="status-dot" aria-hidden="true"></i>{copy.about.status}</span>
	</div>
</MacWindow>

<style is:global>
	.pixel-avatar {
		display: block;
		overflow: hidden;
		width: 88px;
		aspect-ratio: 1;
		padding: 6px;
		border: 1px dashed var(--ink);
		background:
			radial-gradient(var(--line-strong) 0.7px, transparent 0.7px),
			var(--accent-yellow);
		background-size: 3px 3px;
	}

	.pixel-avatar img {
		display: block;
		width: 100%;
		height: 100%;
		border: 1px solid var(--ink);
		object-fit: cover;
	}

	.about-panel h1 {
		margin: 0;
		font-family: var(--font-data);
		font-size: clamp(1.45rem, 2.5vw, 2rem);
		font-weight: 900;
		letter-spacing: -0.03em;
	}

	.about-role {
		margin: 5px 0 12px;
		color: var(--accent-blue-dark);
		font-size: 0.78rem;
		font-weight: 800;
	}

	.about-copy {
		margin: 0;
		color: var(--muted);
		font-size: 0.82rem;
		line-height: 1.65;
	}

	.about-shortcuts a {
		display: grid;
		width: 24px;
		height: 24px;
		place-items: center;
	}

	.about-shortcuts a:hover,
	.about-shortcuts a:focus-visible {
		background: var(--accent-yellow);
		outline: 1px dashed var(--ink);
		outline-offset: 1px;
	}

	.shortcut-icon {
		position: relative;
		display: block;
		width: 18px;
		height: 16px;
	}

	.shortcut-icon--github {
		border: 1px solid var(--ink);
		border-radius: 50%;
		background: var(--ink);
	}

	.shortcut-icon--github::after {
		position: absolute;
		right: 4px;
		bottom: -3px;
		width: 4px;
		height: 6px;
		background: var(--ink);
		content: "";
	}

	.shortcut-icon--folder {
		margin-top: 3px;
		border: 1px solid var(--ink);
		background: var(--accent-yellow);
	}

	.shortcut-icon--folder::before {
		position: absolute;
		top: -4px;
		left: -1px;
		width: 8px;
		height: 4px;
		border: 1px solid var(--ink);
		border-bottom: 0;
		background: var(--accent-yellow);
		content: "";
	}

	.shortcut-icon--mail {
		border: 1px solid var(--ink);
		background: var(--paper);
	}

	.shortcut-icon--mail::before,
	.shortcut-icon--mail::after {
		position: absolute;
		top: 4px;
		width: 10px;
		height: 1px;
		background: var(--ink);
		content: "";
	}

	.shortcut-icon--mail::before {
		left: 0;
		transform: rotate(30deg);
	}

	.shortcut-icon--mail::after {
		right: 0;
		transform: rotate(-30deg);
	}

	.about-status a {
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	@media (max-width: 760px) {
		.pixel-avatar {
			width: 72px;
		}
	}
</style>
