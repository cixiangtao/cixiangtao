---
import MacWindow from './MacWindow.astro';
import {
	detectContentLanguage,
	getAlternateLocale,
	getLocalizedPath,
	getMessages,
	type Locale,
} from '../i18n';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatDate, type BlogPost } from '../lib/github';

interface Props {
	post: BlogPost;
	locale: Locale;
}

const { post, locale } = Astro.props;
const base = import.meta.env.BASE_URL;
const copy = getMessages(locale);
const alternateHref = getLocalizedPath(base, getAlternateLocale(locale), `posts/${post.number}/`);
const writingHref = `${getLocalizedPath(base, locale)}#writing`;
const contentLanguage = detectContentLanguage(`${post.title}\n${post.bodyText}`);
const showOriginalLanguage = locale === 'en' && contentLanguage === 'zh-CN';
---

<BaseLayout title={post.title} description={post.excerpt} locale={locale} alternateHref={alternateHref}>
	<div class="article-desktop mx-auto w-full max-w-[1180px] px-4 py-6 sm:px-6 lg:py-10">
		<MacWindow title={copy.sections.writing} icon="document" tone="cyan" class="article-window">
			<nav class="article-toolbar" aria-label={copy.article.navigation}>
				<a href={writingHref}>{copy.article.back}</a>
				<a href={post.githubUrl} target="_blank" rel="noreferrer">{copy.article.openGitHub}</a>
			</nav>

			<article class="article-sheet">
				<header class="article-header">
					<div class="article-tags">
						<span class="issue-badge">ISSUE {String(post.number).padStart(3, '0')}</span>
						{post.labels.map((label) => <span>#{label.name}</span>)}
					</div>
					{showOriginalLanguage && <p class="article-language-note">{copy.article.originalChinese}</p>}
					<h1 lang={contentLanguage}>{post.title}</h1>
					<p lang={contentLanguage}>{post.excerpt}</p>
					<div class="article-meta">
						<span>{copy.article.published(formatDate(post.createdAt, locale))}</span>
						<span>{copy.article.readTime(post.readingMinutes)}</span>
						<span>{copy.article.discussions(post.comments)}</span>
					</div>
				</header>

				<div class="article-layout">
					<aside class="article-aside" aria-label={copy.article.authorInfo}>
						<img class="author-avatar" src="https://github.com/cixiangtao.png?size=116" alt="" width="58" height="58" decoding="async" />
						<strong>cixiangtao</strong>
						<p>{copy.article.authorCopy}</p>
						<span class="article-file-info">{copy.article.format}<br />{copy.article.status}</span>
					</aside>

					<div class="article-body markdown-body" lang={contentLanguage} set:html={post.bodyHtml} />
				</div>

				<footer class="article-footer">
					<div>
						<strong>{copy.article.discussTitle}</strong>
						<span>{copy.article.discussCopy}</span>
					</div>
					<a href={post.githubUrl} target="_blank" rel="noreferrer">{copy.article.discussAction}</a>
				</footer>
			</article>
		</MacWindow>
	</div>
</BaseLayout>

<style is:global>
	.article-window {
		width: 100%;
	}

	.article-toolbar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 10px 14px;
		border-bottom: 1px solid var(--ink);
		background: var(--paper);
		font-size: 0.72rem;
		font-weight: 850;
	}

	.article-toolbar a {
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.article-sheet {
		padding: clamp(26px, 6vw, 72px);
		background: var(--paper);
	}

	.article-header {
		max-width: 880px;
		margin: 0 auto;
		padding-bottom: clamp(32px, 5vw, 56px);
		border-bottom: 1px solid var(--ink);
	}

	.article-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		align-items: center;
		margin-bottom: 22px;
		color: var(--accent-blue-dark);
		font-family: var(--font-data);
		font-size: 0.68rem;
		font-weight: 800;
	}

	.issue-badge {
		padding: 5px 7px;
		border: 1px solid var(--ink);
		background: var(--accent-yellow);
		color: var(--ink);
	}

	.article-language-note {
		width: fit-content;
		margin: -8px 0 18px;
		padding: 4px 7px;
		border: 1px dashed var(--line-strong);
		color: var(--muted);
		font-family: var(--font-data);
		font-size: 0.62rem;
		font-weight: 800;
	}

	.article-header h1 {
		max-width: 18ch;
		margin: 0;
		font-size: clamp(2.35rem, 7vw, 5.2rem);
		font-weight: 950;
		letter-spacing: -0.04em;
		line-height: 1.08;
		text-wrap: balance;
	}

	.article-header > p:not(.article-language-note) {
		max-width: 62ch;
		margin: 24px 0 0;
		color: var(--muted);
		font-size: 0.94rem;
		line-height: 1.75;
	}

	.article-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 9px 20px;
		margin-top: 24px;
		color: var(--muted);
		font-size: 0.7rem;
		font-weight: 750;
	}

	.article-layout {
		display: grid;
		grid-template-columns: 155px minmax(0, 70ch);
		gap: clamp(38px, 7vw, 82px);
		justify-content: center;
		padding: clamp(42px, 7vw, 76px) 0 24px;
	}

	.article-aside {
		position: sticky;
		top: 78px;
		align-self: start;
		color: var(--muted);
		font-size: 0.72rem;
		line-height: 1.65;
	}

	.author-avatar {
		display: block;
		width: 58px;
		height: 58px;
		margin-bottom: 14px;
		border: 1px solid var(--ink);
		background: var(--accent-yellow);
		object-fit: cover;
	}

	.article-aside strong {
		display: block;
		color: var(--ink);
		font-size: 0.8rem;
		font-weight: 900;
	}

	.article-aside p {
		margin: 8px 0 18px;
	}

	.article-file-info {
		display: block;
		padding-top: 13px;
		border-top: 1px solid var(--line-strong);
		font-family: var(--font-data);
		font-size: 0.62rem;
		line-height: 1.7;
	}

	.article-footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 880px;
		margin: 62px auto 0;
		padding: 20px 22px;
		border: 1px solid var(--ink);
		background: var(--accent-yellow);
		box-shadow: 4px 4px 0 rgb(23 23 27 / 22%);
	}

	.article-footer strong,
	.article-footer span {
		display: block;
	}

	.article-footer strong {
		font-size: 0.88rem;
		font-weight: 900;
	}

	.article-footer span {
		margin-top: 4px;
		font-size: 0.68rem;
		line-height: 1.5;
	}

	.article-footer a {
		flex: none;
		padding: 10px 13px;
		border: 1px solid var(--ink);
		background: var(--selection);
		color: white;
		font-size: 0.72rem;
		font-weight: 900;
	}

	.article-footer a:hover,
	.article-footer a:focus-visible {
		background: var(--ink);
	}

	@media (max-width: 760px) {
		.article-toolbar,
		.article-footer {
			align-items: flex-start;
			flex-direction: column;
			gap: 12px;
		}

		.article-sheet {
			padding-inline: 18px;
		}

		.article-layout {
			grid-template-columns: 1fr;
			gap: 32px;
		}

		.article-aside {
			position: static;
			display: grid;
			grid-template-columns: 48px minmax(0, 1fr);
			gap: 0 12px;
			padding-bottom: 22px;
			border-bottom: 1px solid var(--line-strong);
		}

		.author-avatar {
			grid-row: span 3;
			width: 48px;
			height: 48px;
			margin: 0;
			font-size: 1.3rem;
		}

		.article-aside p {
			margin: 4px 0 0;
		}

		.article-file-info {
			display: none;
		}
	}
</style>
