---
import ModuleIcon from './ModuleIcon.astro';

/** Renders a classic desktop shortcut for an internal workspace window. */
interface Props {
	href: string;
	label: string;
	icon: 'folder' | 'document' | 'profile';
}

const { href, label, icon } = Astro.props;
---

<a
	class="grid w-17 justify-items-center gap-1.5 text-[0.68rem] font-extrabold !text-white [text-shadow:1px_1px_0_var(--ink)] focus-visible:bg-[var(--selection)]"
	href={href}
>
	<ModuleIcon name={icon} size="desktop" />
	{label}
</a>
