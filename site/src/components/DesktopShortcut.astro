---
import ModuleIcon from './ModuleIcon.astro';
import { getMessages, type Locale } from '../i18n';

/** Renders a classic desktop shortcut for an internal workspace window. */
interface Props {
	href: string;
	label: string;
	icon: 'folder' | 'document' | 'profile';
	locale: Locale;
}

const { href, label, icon, locale } = Astro.props;
const copy = getMessages(locale).shortcut;
const windowId = href.startsWith('#') ? href.slice(1) : href;
---

<a
	class="desktop-shortcut grid w-17 justify-items-center gap-1.5 text-[0.68rem] font-extrabold !text-white [text-shadow:1px_1px_0_var(--ink)]"
	href={href}
	aria-controls={windowId}
	aria-label={copy.switchTo(label)}
	title={copy.desktopHint(label)}
	data-window-desktop-title={copy.desktopHint(label)}
	data-window-label={label}
	data-window-open="true"
	data-window-open-label={copy.open(label)}
	data-window-shortcut
	data-window-switch-label={copy.switchTo(label)}
	data-window-target={windowId}
	data-window-touch-title={copy.touchHint(label)}
>
	<ModuleIcon name={icon} size="desktop" />
	<span class="desktop-shortcut-label">{label}</span>
</a>

<style is:global>
	.desktop-shortcut {
		cursor: default;
		user-select: none;
		-webkit-user-drag: none;
	}

	.desktop-shortcut-label {
		padding: 1px 4px;
	}

	.desktop-shortcut[data-selected] .desktop-shortcut-label,
	.desktop-shortcut:focus-visible .desktop-shortcut-label {
		background: var(--selection);
		outline: 1px dotted white;
		outline-offset: -2px;
	}

	.desktop-shortcut:focus-visible {
		outline: none;
	}

	.desktop-shortcut[data-window-open="false"] .module-icon {
		filter: grayscale(0.25) drop-shadow(2px 3px 0 rgb(21 23 29 / 24%));
		opacity: 0.88;
	}
</style>
