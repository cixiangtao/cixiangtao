---
/** Renders a classic desktop shortcut with an optional external-link contract. */
interface Props {
	href: string;
	label: string;
	icon: 'computer' | 'document';
	external?: boolean;
}

const { href, label, icon, external = false } = Astro.props;
---

<a
	class="grid w-17 justify-items-center gap-1.5 text-[0.68rem] font-extrabold !text-white [text-shadow:1px_1px_0_var(--ink)] focus-visible:bg-[var(--selection)]"
	href={href}
	target={external ? '_blank' : undefined}
	rel={external ? 'noreferrer' : undefined}
>
	<span class:list={['desktop-icon', `desktop-icon--${icon}`]} aria-hidden="true"><i></i></span>
	{label}
</a>

<style>
	@media (min-width: 1024px) {
		.desktop-icon {
			position: relative;
			display: block;
			width: 48px;
			height: 42px;
			border: 1px solid var(--ink);
			background: var(--paper);
			box-shadow: 3px 4px 0 rgb(21 23 29 / 28%);
		}

		.desktop-icon--computer::before {
			position: absolute;
			inset: 6px 6px 11px;
			border: 2px solid var(--ink);
			background: var(--accent-cyan);
			content: "";
		}

		.desktop-icon--computer::after {
			position: absolute;
			bottom: 4px;
			left: 15px;
			width: 16px;
			height: 3px;
			background: var(--ink);
			content: "";
		}

		.desktop-icon--document::before {
			position: absolute;
			inset: 7px 9px;
			border: 2px solid var(--ink);
			background: var(--accent-yellow);
			content: "";
		}

		.desktop-icon--document::after {
			position: absolute;
			right: 12px;
			bottom: 10px;
			width: 8px;
			height: 8px;
			background: var(--accent-coral);
			content: "";
		}
	}
</style>
