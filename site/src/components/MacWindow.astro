---
import ModuleIcon from './ModuleIcon.astro';

interface Props {
	id?: string;
	title: string;
	icon: 'folder' | 'document' | 'profile';
	class?: string;
	tone?: 'paper' | 'cyan' | 'yellow' | 'coral';
	label?: string;
	scrollbars?: boolean;
	closeLabel?: string;
	/** Minimum desktop resize width in CSS pixels. */
	minWidth?: number;
	/** Minimum desktop resize height in CSS pixels. */
	minHeight?: number;
	/** Prevent desktop resizing from making sequential body content overflow vertically. */
	fitContentHeight?: boolean;
}

const {
	id,
	title,
	icon,
	class: className = '',
	tone = 'paper',
	label = title,
	scrollbars = false,
	closeLabel = `Close “${title}” window`,
	minWidth = 320,
	minHeight = 220,
	fitContentHeight = false,
} = Astro.props;
const resizeEdges = ['n', 'ne', 'e', 'se', 's', 'sw', 'w', 'nw'] as const;
---

<section
	id={id}
	class:list={['mac-window', `mac-window--${tone}`, className]}
	aria-label={label}
	data-window-min-width={id ? minWidth : undefined}
	data-window-min-height={id ? minHeight : undefined}
	data-window-fit-content-height={id && fitContentHeight ? '' : undefined}
>
	<header class="mac-titlebar">
		<ModuleIcon name={icon} size="window" />
		<div class="mac-title-lines" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
		<h2>{title}</h2>
		<div class="mac-title-lines" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
		<div class="mac-window-controls">
			<span class="mac-control mac-control--minimize" aria-hidden="true"></span>
			<span class="mac-control mac-control--maximize" aria-hidden="true"></span>
			{id ? (
				<button
					class="mac-control mac-control--close"
					type="button"
					aria-label={closeLabel}
					title={closeLabel}
					data-window-close
				></button>
			) : (
				<span class="mac-control mac-control--close" aria-hidden="true"></span>
			)}
		</div>
	</header>
	<div class:list={['mac-window-content', { 'mac-window-content--scrollable': scrollbars }]}>
		<div class="mac-window-body">
			<slot />
		</div>
		{scrollbars && (
			<div class="mac-scrollbar mac-scrollbar--vertical" aria-hidden="true">
				<span class="mac-scroll-arrow mac-scroll-arrow--up"></span>
				<i class="mac-scroll-track"><b></b></i>
				<span class="mac-scroll-arrow mac-scroll-arrow--down"></span>
			</div>
		)}
	</div>
	{scrollbars && (
		<div class="mac-scrollbar mac-scrollbar--horizontal" aria-hidden="true">
			<span class="mac-scroll-arrow mac-scroll-arrow--left"></span>
			<i class="mac-scroll-track"><b></b></i>
			<span class="mac-scroll-arrow mac-scroll-arrow--right"></span>
		</div>
	)}
	{id && (
		<div class="mac-resize-handles" aria-hidden="true">
			{resizeEdges.map((direction) => <span class:list={['mac-resize-handle', `mac-resize-handle--${direction}`]} data-window-resize={direction}></span>)}
		</div>
	)}
</section>

<script>
	const resizeDirections = ['n', 'ne', 'e', 'se', 's', 'sw', 'w', 'nw'] as const;
	type ResizeDirection = (typeof resizeDirections)[number];
	const selectableWindows = '.mac-window[id]';
	const desktopWindowQuery = window.matchMedia('(min-width: 1024px)');
	const reducedMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
	const closeTimers = new WeakMap<HTMLElement, number>();
	const defaultMinimumWindowWidth = 320;
	const defaultMinimumWindowHeight = 220;
	let fitWindowsFrame = 0;
	let topWindowLayer = 0;

	function clamp(value: number, min: number, max: number) {
		return Math.min(Math.max(value, min), max);
	}

	function isResizeDirection(value: string | undefined): value is ResizeDirection {
		return resizeDirections.some((direction) => direction === value);
	}

	function getContentMinimumHeight(panel: HTMLElement) {
		if (!panel.hasAttribute('data-window-fit-content-height')) return 0;

		const titlebar = panel.querySelector<HTMLElement>(':scope > .mac-titlebar');
		const body = panel.querySelector<HTMLElement>(':scope > .mac-window-content > .mac-window-body');
		const horizontalScrollbar = panel.querySelector<HTMLElement>(':scope > .mac-scrollbar--horizontal');
		if (!titlebar || !body) return 0;

		const bodyStyle = window.getComputedStyle(body);
		const panelStyle = window.getComputedStyle(panel);
		const bodyChildren = [...body.children];
		const bodyPadding = Number.parseFloat(bodyStyle.paddingTop) + Number.parseFloat(bodyStyle.paddingBottom);
		const bodyGap = (Number.parseFloat(bodyStyle.rowGap) || 0) * Math.max(0, bodyChildren.length - 1);
		const bodyContentHeight = bodyChildren.reduce((height, child) => {
			const childStyle = window.getComputedStyle(child);
			return height
				+ child.getBoundingClientRect().height
				+ (Number.parseFloat(childStyle.marginTop) || 0)
				+ (Number.parseFloat(childStyle.marginBottom) || 0);
		}, bodyPadding + bodyGap);
		const panelBorders = Number.parseFloat(panelStyle.borderTopWidth) + Number.parseFloat(panelStyle.borderBottomWidth);

		return Math.ceil(
			panelBorders
			+ titlebar.getBoundingClientRect().height
			+ bodyContentHeight
			+ (horizontalScrollbar?.getBoundingClientRect().height ?? 0),
		);
	}

	function getWindow(id: string) {
		const panel = document.getElementById(id);
		return panel?.matches(selectableWindows) ? panel : null;
	}

	function getShortcut(id: string) {
		return document.querySelector<HTMLElement>(`[data-window-shortcut][data-window-target="${id}"]`);
	}

	function selectShortcut(selectedShortcut: Element | null) {
		document.querySelectorAll('[data-window-shortcut]').forEach((shortcut) => {
			shortcut.toggleAttribute('data-selected', shortcut === selectedShortcut);
		});
	}

	function syncShortcutState(panel: HTMLElement) {
		const shortcut = getShortcut(panel.id);
		if (!shortcut) return;

		const isOpen = !panel.hidden && !panel.hasAttribute('data-closing');
		shortcut.dataset.windowOpen = String(isOpen);
		shortcut.setAttribute(
			'aria-label',
			isOpen ? shortcut.dataset.windowSwitchLabel ?? panel.id : shortcut.dataset.windowOpenLabel ?? panel.id,
		);
		shortcut.setAttribute(
			'title',
			desktopWindowQuery.matches
				? shortcut.dataset.windowDesktopTitle ?? ''
				: shortcut.dataset.windowTouchTitle ?? '',
		);
	}

	function syncAllShortcutStates() {
		document.querySelectorAll<HTMLElement>(selectableWindows).forEach(syncShortcutState);
	}

	function getWindowLayer(panel: HTMLElement) {
		const assignedLayer = Number.parseInt(panel.style.getPropertyValue('--window-layer'), 10);
		if (Number.isFinite(assignedLayer)) return assignedLayer;

		return Number.parseInt(window.getComputedStyle(panel).zIndex, 10) || 0;
	}

	function bringWindowToFront(panel: HTMLElement) {
		if (!desktopWindowQuery.matches) return;

		const currentTopLayer = Math.max(
			topWindowLayer,
			...[...document.querySelectorAll<HTMLElement>(selectableWindows)].map(getWindowLayer),
		);
		topWindowLayer = currentTopLayer + 1;
		panel.style.setProperty('--window-layer', String(topWindowLayer));
		panel.toggleAttribute('data-window-layered', true);
	}

	function fitWindowToStage(panel: HTMLElement) {
		if (!desktopWindowQuery.matches || panel.hidden || !panel.hasAttribute('data-window-resized')) return;

		const stage = panel.closest<HTMLElement>('.desktop-stage');
		if (!stage) return;

		const panelRect = panel.getBoundingClientRect();
		const stageRect = stage.getBoundingClientRect();
		const width = Math.min(panelRect.width, stageRect.width);
		const height = Math.min(panelRect.height, stageRect.height);
		const left = clamp(panelRect.left - stageRect.left, 0, Math.max(0, stageRect.width - width));
		const top = clamp(panelRect.top - stageRect.top, 0, Math.max(0, stageRect.height - height));

		panel.style.left = `${Math.floor(left)}px`;
		panel.style.top = `${Math.floor(top)}px`;
		panel.style.right = 'auto';
		panel.style.bottom = 'auto';
		panel.style.setProperty('--window-width', `${Math.floor(width)}px`);
		panel.style.setProperty('--window-height', `${Math.floor(height)}px`);
	}

	function scheduleFitWindowsToStage() {
		if (fitWindowsFrame) return;

		fitWindowsFrame = window.requestAnimationFrame(() => {
			fitWindowsFrame = 0;
			document.querySelectorAll<HTMLElement>(`${selectableWindows}[data-window-resized]`).forEach(fitWindowToStage);
		});
	}

	function selectWindow(selectedWindow: HTMLElement | null) {
		const visibleWindow = selectedWindow && !selectedWindow.hidden ? selectedWindow : null;
		if (visibleWindow) bringWindowToFront(visibleWindow);
		document.querySelectorAll<HTMLElement>(selectableWindows).forEach((panel) => {
			panel.toggleAttribute('data-selected', panel === visibleWindow);
		});
		selectShortcut(visibleWindow ? getShortcut(visibleWindow.id) : null);
	}

	function syncSelectedWindow() {
		const id = window.location.hash.slice(1);
		const selectedWindow = id ? getWindow(id) : null;

		if (selectedWindow) revealWindow(selectedWindow);
		selectWindow(selectedWindow);
	}

	function syncWindowHash(selectedWindow: Element) {
		if (window.location.hash === `#${selectedWindow.id}`) return;

		const url = new URL(window.location.href);
		url.hash = selectedWindow.id;
		window.history.replaceState(window.history.state, '', url);
		window.dispatchEvent(new CustomEvent('workspace:navigate', { detail: { id: selectedWindow.id } }));
	}

	function syncHomeHash() {
		const url = new URL(window.location.href);
		url.hash = '';
		window.history.replaceState(window.history.state, '', url);
		window.dispatchEvent(new CustomEvent('workspace:navigate', { detail: { id: 'home' } }));
	}

	function revealWindow(panel: HTMLElement) {
		const timer = closeTimers.get(panel);
		if (timer !== undefined) {
			window.clearTimeout(timer);
			closeTimers.delete(panel);
		}

		const wasHidden = panel.hidden || panel.hasAttribute('data-closing');
		panel.hidden = false;
		panel.removeAttribute('data-closing');
		fitWindowToStage(panel);
		if (wasHidden && !reducedMotionQuery.matches) {
			panel.toggleAttribute('data-opening', true);
			window.setTimeout(() => panel.removeAttribute('data-opening'), 160);
		}
		syncShortcutState(panel);
	}

	function activateWindow(id: string) {
		const panel = getWindow(id);
		if (!panel) return;

		revealWindow(panel);
		selectWindow(panel);
		syncWindowHash(panel);
	}

	function getFrontmostVisibleWindow(excludedWindow: HTMLElement) {
		return [...document.querySelectorAll<HTMLElement>(selectableWindows)]
			.filter((panel) => panel !== excludedWindow && !panel.hidden && !panel.hasAttribute('data-closing'))
			.toSorted((a, b) => {
				const aIndex = Number.parseInt(window.getComputedStyle(a).zIndex, 10) || 0;
				const bIndex = Number.parseInt(window.getComputedStyle(b).zIndex, 10) || 0;
				return bIndex - aIndex;
			})[0] ?? null;
	}

	function closeWindow(panel: HTMLElement) {
		if (panel.hidden || panel.hasAttribute('data-closing')) return;

		const wasSelected = panel.hasAttribute('data-selected') || window.location.hash === `#${panel.id}`;
		panel.toggleAttribute('data-closing', true);
		panel.removeAttribute('data-selected');
		syncShortcutState(panel);

		if (wasSelected) {
			const fallbackWindow = getFrontmostVisibleWindow(panel);
			selectWindow(fallbackWindow);
			if (fallbackWindow) syncWindowHash(fallbackWindow);
			else syncHomeHash();
		}

		const finishClose = () => {
			panel.hidden = true;
			panel.removeAttribute('data-closing');
			panel.removeAttribute('data-opening');
			closeTimers.delete(panel);
			syncShortcutState(panel);
			getShortcut(panel.id)?.focus({ preventScroll: true });
		};

		if (reducedMotionQuery.matches) {
			finishClose();
		} else {
			closeTimers.set(panel, window.setTimeout(finishClose, 120));
		}
	}

	function beginWindowDrag(event: PointerEvent) {
		if (
			event.button !== 0 ||
			!desktopWindowQuery.matches ||
			!(event.currentTarget instanceof HTMLElement) ||
			!(event.target instanceof Element) ||
			event.target.closest('.mac-window-controls')
		) return;

		const handle = event.currentTarget;
		const panel = handle.closest<HTMLElement>(selectableWindows);
		if (!panel) return;
		const dragPanel = panel;

		const stage = dragPanel.closest<HTMLElement>('.desktop-stage');
		if (!stage) return;

		event.preventDefault();
		const panelRect = dragPanel.getBoundingClientRect();
		const stageRect = stage.getBoundingClientRect();
		const originLeft = panelRect.left - stageRect.left;
		const originTop = panelRect.top - stageRect.top;
		const maxLeft = Math.max(0, stage.clientWidth - panelRect.width);
		const maxTop = Math.max(0, stage.clientHeight - panelRect.height);
		const pointerId = event.pointerId;
		const startX = event.clientX;
		const startY = event.clientY;
		let finalLeft = originLeft;
		let finalTop = originTop;
		let dragging = true;

		dragPanel.style.left = `${originLeft}px`;
		dragPanel.style.top = `${originTop}px`;
		dragPanel.style.right = 'auto';
		dragPanel.style.bottom = 'auto';
		dragPanel.toggleAttribute('data-dragging', true);

		function moveWindow(moveEvent: PointerEvent) {
			if (moveEvent.pointerId !== pointerId) return;

			finalLeft = clamp(originLeft + moveEvent.clientX - startX, 0, maxLeft);
			finalTop = clamp(originTop + moveEvent.clientY - startY, 0, maxTop);
			dragPanel.style.transform = `translate3d(${finalLeft - originLeft}px, ${finalTop - originTop}px, 0)`;
		}

		function finishWindowDrag(finishEvent?: PointerEvent) {
			if (!dragging || (finishEvent && finishEvent.pointerId !== pointerId)) return;
			dragging = false;

			window.removeEventListener('pointermove', moveWindow);
			window.removeEventListener('pointerup', finishWindowDrag);
			window.removeEventListener('pointercancel', finishWindowDrag);
			window.removeEventListener('blur', finishWindowDragOnBlur);

			dragPanel.style.left = `${finalLeft}px`;
			dragPanel.style.top = `${finalTop}px`;
			dragPanel.style.transform = '';
			dragPanel.removeAttribute('data-dragging');
		}

		function finishWindowDragOnBlur() {
			finishWindowDrag();
		}

		window.addEventListener('pointermove', moveWindow);
		window.addEventListener('pointerup', finishWindowDrag);
		window.addEventListener('pointercancel', finishWindowDrag);
		window.addEventListener('blur', finishWindowDragOnBlur);
	}

	function beginWindowResize(event: PointerEvent) {
		if (
			event.button !== 0 ||
			!desktopWindowQuery.matches ||
			!(event.currentTarget instanceof HTMLElement)
		) return;

		const handle = event.currentTarget;
		const direction = handle.dataset.windowResize;
		if (!isResizeDirection(direction)) return;
		const resizeDirection = direction;

		const panel = handle.closest<HTMLElement>(selectableWindows);
		const stage = panel?.closest<HTMLElement>('.desktop-stage');
		if (!panel || !stage) return;
		const resizePanel = panel;

		event.preventDefault();
		event.stopPropagation();
		selectWindow(resizePanel);

		const panelRect = resizePanel.getBoundingClientRect();
		const stageRect = stage.getBoundingClientRect();
		const startLeft = panelRect.left - stageRect.left;
		const startTop = panelRect.top - stageRect.top;
		const startWidth = panelRect.width;
		const startHeight = panelRect.height;
		const startRight = startLeft + startWidth;
		const startBottom = startTop + startHeight;
		const requestedMinimumWidth = Number.parseInt(resizePanel.dataset.windowMinWidth ?? '', 10) || defaultMinimumWindowWidth;
		const requestedMinimumHeight = Number.parseInt(resizePanel.dataset.windowMinHeight ?? '', 10) || defaultMinimumWindowHeight;
		const availableWidth = resizeDirection.includes('w') ? startRight : stageRect.width - startLeft;
		const availableHeight = resizeDirection.includes('n') ? startBottom : stageRect.height - startTop;
		const minimumWidth = Math.min(
			requestedMinimumWidth,
			availableWidth,
		);
		const pointerId = event.pointerId;
		const startX = event.clientX;
		const startY = event.clientY;
		let resizing = true;

		resizePanel.style.left = `${startLeft}px`;
		resizePanel.style.top = `${startTop}px`;
		resizePanel.style.right = 'auto';
		resizePanel.style.bottom = 'auto';
		resizePanel.style.setProperty('--window-width', `${startWidth}px`);
		resizePanel.style.setProperty('--window-height', `${startHeight}px`);
		resizePanel.toggleAttribute('data-window-resized', true);
		resizePanel.toggleAttribute('data-resizing', true);

		function resizeWindow(moveEvent: PointerEvent) {
			if (moveEvent.pointerId !== pointerId) return;

			const deltaX = moveEvent.clientX - startX;
			const deltaY = moveEvent.clientY - startY;
			let left = startLeft;
			let top = startTop;
			let width = startWidth;
			let height = startHeight;

			if (resizeDirection.includes('w')) {
				left = clamp(startLeft + deltaX, 0, startRight - minimumWidth);
				width = startRight - left;
			} else if (resizeDirection.includes('e')) {
				width = clamp(startWidth + deltaX, minimumWidth, stageRect.width - startLeft);
			}
			resizePanel.style.left = `${Math.floor(left)}px`;
			resizePanel.style.setProperty('--window-width', `${Math.floor(width)}px`);

			const minimumHeight = Math.min(
				Math.max(requestedMinimumHeight, getContentMinimumHeight(resizePanel)),
				availableHeight,
			);

			if (resizeDirection.includes('n')) {
				top = clamp(startTop + deltaY, 0, startBottom - minimumHeight);
				height = startBottom - top;
			} else if (resizeDirection.includes('s')) {
				height = clamp(startHeight + deltaY, minimumHeight, stageRect.height - startTop);
			} else {
				height = Math.max(startHeight, minimumHeight);
			}

			resizePanel.style.top = `${Math.floor(top)}px`;
			resizePanel.style.setProperty('--window-height', `${Math.floor(height)}px`);
		}

		function finishWindowResize(finishEvent?: PointerEvent) {
			if (!resizing || (finishEvent && finishEvent.pointerId !== pointerId)) return;
			resizing = false;

			window.removeEventListener('pointermove', resizeWindow);
			window.removeEventListener('pointerup', finishWindowResize);
			window.removeEventListener('pointercancel', finishWindowResize);
			window.removeEventListener('blur', finishWindowResizeOnBlur);
			resizePanel.removeAttribute('data-resizing');
		}

		function finishWindowResizeOnBlur() {
			finishWindowResize();
		}

		window.addEventListener('pointermove', resizeWindow);
		window.addEventListener('pointerup', finishWindowResize);
		window.addEventListener('pointercancel', finishWindowResize);
		window.addEventListener('blur', finishWindowResizeOnBlur);
	}

	document.addEventListener('pointerdown', (event) => {
		if (event.button !== 0 || !(event.target instanceof Element)) return;

		const selectedWindow = event.target.closest<HTMLElement>(selectableWindows);
		if (!selectedWindow) return;

		selectWindow(selectedWindow);
	});

	document.addEventListener('click', (event) => {
		if (!(event.target instanceof Element)) return;

		const closeButton = event.target.closest<HTMLElement>('[data-window-close]');
		if (closeButton) {
			event.preventDefault();
			event.stopPropagation();
			const panel = closeButton.closest<HTMLElement>(selectableWindows);
			if (panel) closeWindow(panel);
			return;
		}

		const shortcut = event.target.closest<HTMLElement>('[data-window-shortcut]');
		if (!shortcut) return;

		event.preventDefault();
		const id = shortcut.dataset.windowTarget;
		if (!id) return;

		if (!desktopWindowQuery.matches || event instanceof MouseEvent && event.detail === 0) {
			activateWindow(id);
		} else {
			selectShortcut(shortcut);
		}
	});

	document.addEventListener('dblclick', (event) => {
		if (!desktopWindowQuery.matches || !(event.target instanceof Element)) return;

		const shortcut = event.target.closest<HTMLElement>('[data-window-shortcut]');
		if (!shortcut) return;

		event.preventDefault();
		const id = shortcut.dataset.windowTarget;
		if (id) activateWindow(id);
	});

	document.querySelectorAll<HTMLElement>(`${selectableWindows} > .mac-titlebar`).forEach((handle) => {
		handle.addEventListener('pointerdown', beginWindowDrag);
	});
	document.querySelectorAll<HTMLElement>(`${selectableWindows} [data-window-resize]`).forEach((handle) => {
		handle.addEventListener('pointerdown', beginWindowResize);
	});

	window.addEventListener('hashchange', syncSelectedWindow);
	desktopWindowQuery.addEventListener('change', () => {
		syncAllShortcutStates();
		scheduleFitWindowsToStage();
	});
	window.addEventListener('resize', scheduleFitWindowsToStage);
	syncAllShortcutStates();
	syncSelectedWindow();
</script>
