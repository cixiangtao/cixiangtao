---
import ModuleIcon from './ModuleIcon.astro';

interface Props {
	id?: string;
	title: string;
	icon: 'folder' | 'document' | 'profile';
	class?: string;
	tone?: 'paper' | 'cyan' | 'yellow' | 'coral';
	label?: string;
	scrollbars?: boolean;
}

const {
	id,
	title,
	icon,
	class: className = '',
	tone = 'paper',
	label = title,
	scrollbars = false,
} = Astro.props;
---

<section id={id} class:list={['mac-window', `mac-window--${tone}`, className]} aria-label={label}>
	<header class="mac-titlebar">
		<ModuleIcon name={icon} size="window" />
		<div class="mac-title-lines" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
		<h2>{title}</h2>
		<div class="mac-title-lines" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
		<div class="mac-window-controls">
			<span class="mac-control mac-control--minimize" aria-hidden="true"></span>
			<span class="mac-control mac-control--maximize" aria-hidden="true"></span>
			{id ? (
				<button
					class="mac-control mac-control--close"
					type="button"
					aria-label={`关闭“${title}”窗口`}
					title={`关闭“${title}”窗口`}
					data-window-close
				></button>
			) : (
				<span class="mac-control mac-control--close" aria-hidden="true"></span>
			)}
		</div>
	</header>
	<div class:list={['mac-window-content', { 'mac-window-content--scrollable': scrollbars }]}>
		<div class="mac-window-body">
			<slot />
		</div>
		{scrollbars && (
			<div class="mac-scrollbar mac-scrollbar--vertical" aria-hidden="true">
				<span class="mac-scroll-arrow mac-scroll-arrow--up"></span>
				<i class="mac-scroll-track"><b></b></i>
				<span class="mac-scroll-arrow mac-scroll-arrow--down"></span>
			</div>
		)}
	</div>
	{scrollbars && (
		<div class="mac-scrollbar mac-scrollbar--horizontal" aria-hidden="true">
			<span class="mac-scroll-arrow mac-scroll-arrow--left"></span>
			<i class="mac-scroll-track"><b></b></i>
			<span class="mac-scroll-arrow mac-scroll-arrow--right"></span>
			<span class="mac-resize-grip"></span>
		</div>
	)}
</section>

<script>
	const selectableWindows = '.mac-window[id]';
	const desktopWindowQuery = window.matchMedia('(min-width: 1024px)');
	const reducedMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
	const closeTimers = new WeakMap<HTMLElement, number>();

	function clamp(value: number, min: number, max: number) {
		return Math.min(Math.max(value, min), max);
	}

	function getWindow(id: string) {
		const panel = document.getElementById(id);
		return panel?.matches(selectableWindows) ? panel : null;
	}

	function getShortcut(id: string) {
		return document.querySelector<HTMLElement>(`[data-window-shortcut][data-window-target="${id}"]`);
	}

	function selectShortcut(selectedShortcut: Element | null) {
		document.querySelectorAll('[data-window-shortcut]').forEach((shortcut) => {
			shortcut.toggleAttribute('data-selected', shortcut === selectedShortcut);
		});
	}

	function syncShortcutState(panel: HTMLElement) {
		const shortcut = getShortcut(panel.id);
		if (!shortcut) return;

		const isOpen = !panel.hidden && !panel.hasAttribute('data-closing');
		const label = shortcut.dataset.windowLabel ?? panel.id;
		shortcut.dataset.windowOpen = String(isOpen);
		shortcut.setAttribute('aria-label', isOpen ? `切换到${label}窗口` : `打开${label}窗口`);
		shortcut.setAttribute(
			'title',
			desktopWindowQuery.matches ? `双击打开或置顶“${label}”窗口` : `点按打开或置顶“${label}”窗口`,
		);
	}

	function syncAllShortcutStates() {
		document.querySelectorAll<HTMLElement>(selectableWindows).forEach(syncShortcutState);
	}

	function selectWindow(selectedWindow: HTMLElement | null) {
		const visibleWindow = selectedWindow && !selectedWindow.hidden ? selectedWindow : null;
		document.querySelectorAll<HTMLElement>(selectableWindows).forEach((panel) => {
			panel.toggleAttribute('data-selected', panel === visibleWindow);
		});
		selectShortcut(visibleWindow ? getShortcut(visibleWindow.id) : null);
	}

	function syncSelectedWindow() {
		const id = window.location.hash.slice(1);
		const selectedWindow = id ? getWindow(id) : null;

		if (selectedWindow) revealWindow(selectedWindow);
		selectWindow(selectedWindow);
	}

	function syncWindowHash(selectedWindow: Element) {
		if (window.location.hash === `#${selectedWindow.id}`) return;

		const url = new URL(window.location.href);
		url.hash = selectedWindow.id;
		window.history.replaceState(window.history.state, '', url);
		window.dispatchEvent(new CustomEvent('workspace:navigate', { detail: { id: selectedWindow.id } }));
	}

	function syncHomeHash() {
		const url = new URL(window.location.href);
		url.hash = '';
		window.history.replaceState(window.history.state, '', url);
		window.dispatchEvent(new CustomEvent('workspace:navigate', { detail: { id: 'home' } }));
	}

	function revealWindow(panel: HTMLElement) {
		const timer = closeTimers.get(panel);
		if (timer !== undefined) {
			window.clearTimeout(timer);
			closeTimers.delete(panel);
		}

		const wasHidden = panel.hidden || panel.hasAttribute('data-closing');
		panel.hidden = false;
		panel.removeAttribute('data-closing');
		if (wasHidden && !reducedMotionQuery.matches) {
			panel.toggleAttribute('data-opening', true);
			window.setTimeout(() => panel.removeAttribute('data-opening'), 160);
		}
		syncShortcutState(panel);
	}

	function activateWindow(id: string) {
		const panel = getWindow(id);
		if (!panel) return;

		revealWindow(panel);
		selectWindow(panel);
		syncWindowHash(panel);
	}

	function getFrontmostVisibleWindow(excludedWindow: HTMLElement) {
		return [...document.querySelectorAll<HTMLElement>(selectableWindows)]
			.filter((panel) => panel !== excludedWindow && !panel.hidden && !panel.hasAttribute('data-closing'))
			.toSorted((a, b) => {
				const aIndex = Number.parseInt(window.getComputedStyle(a).zIndex, 10) || 0;
				const bIndex = Number.parseInt(window.getComputedStyle(b).zIndex, 10) || 0;
				return bIndex - aIndex;
			})[0] ?? null;
	}

	function closeWindow(panel: HTMLElement) {
		if (panel.hidden || panel.hasAttribute('data-closing')) return;

		const wasSelected = panel.hasAttribute('data-selected') || window.location.hash === `#${panel.id}`;
		panel.toggleAttribute('data-closing', true);
		panel.removeAttribute('data-selected');
		syncShortcutState(panel);

		if (wasSelected) {
			const fallbackWindow = getFrontmostVisibleWindow(panel);
			selectWindow(fallbackWindow);
			if (fallbackWindow) syncWindowHash(fallbackWindow);
			else syncHomeHash();
		}

		const finishClose = () => {
			panel.hidden = true;
			panel.removeAttribute('data-closing');
			panel.removeAttribute('data-opening');
			closeTimers.delete(panel);
			syncShortcutState(panel);
			getShortcut(panel.id)?.focus({ preventScroll: true });
		};

		if (reducedMotionQuery.matches) {
			finishClose();
		} else {
			closeTimers.set(panel, window.setTimeout(finishClose, 120));
		}
	}

	function beginWindowDrag(event: PointerEvent) {
		if (
			event.button !== 0 ||
			!desktopWindowQuery.matches ||
			!(event.currentTarget instanceof HTMLElement) ||
			!(event.target instanceof Element) ||
			event.target.closest('.mac-window-controls')
		) return;

		const handle = event.currentTarget;
		const panel = handle.closest<HTMLElement>(selectableWindows);
		if (!panel) return;
		const dragPanel = panel;

		const stage = dragPanel.closest<HTMLElement>('.desktop-stage');
		if (!stage) return;

		event.preventDefault();
		selectWindow(dragPanel);
		syncWindowHash(dragPanel);

		const panelRect = dragPanel.getBoundingClientRect();
		const stageRect = stage.getBoundingClientRect();
		const originLeft = panelRect.left - stageRect.left;
		const originTop = panelRect.top - stageRect.top;
		const maxLeft = Math.max(0, stage.clientWidth - panelRect.width);
		const maxTop = Math.max(0, stage.clientHeight - panelRect.height);
		const pointerId = event.pointerId;
		const startX = event.clientX;
		const startY = event.clientY;
		let finalLeft = originLeft;
		let finalTop = originTop;
		let dragging = true;

		dragPanel.style.left = `${originLeft}px`;
		dragPanel.style.top = `${originTop}px`;
		dragPanel.style.right = 'auto';
		dragPanel.style.bottom = 'auto';
		dragPanel.toggleAttribute('data-dragging', true);

		function moveWindow(moveEvent: PointerEvent) {
			if (moveEvent.pointerId !== pointerId) return;

			finalLeft = clamp(originLeft + moveEvent.clientX - startX, 0, maxLeft);
			finalTop = clamp(originTop + moveEvent.clientY - startY, 0, maxTop);
			dragPanel.style.transform = `translate3d(${finalLeft - originLeft}px, ${finalTop - originTop}px, 0)`;
		}

		function finishWindowDrag(finishEvent?: PointerEvent) {
			if (!dragging || (finishEvent && finishEvent.pointerId !== pointerId)) return;
			dragging = false;

			window.removeEventListener('pointermove', moveWindow);
			window.removeEventListener('pointerup', finishWindowDrag);
			window.removeEventListener('pointercancel', finishWindowDrag);
			window.removeEventListener('blur', finishWindowDragOnBlur);

			dragPanel.style.left = `${finalLeft}px`;
			dragPanel.style.top = `${finalTop}px`;
			dragPanel.style.transform = '';
			dragPanel.removeAttribute('data-dragging');
		}

		function finishWindowDragOnBlur() {
			finishWindowDrag();
		}

		window.addEventListener('pointermove', moveWindow);
		window.addEventListener('pointerup', finishWindowDrag);
		window.addEventListener('pointercancel', finishWindowDrag);
		window.addEventListener('blur', finishWindowDragOnBlur);
	}

	document.addEventListener('pointerdown', (event) => {
		if (event.button !== 0 || !(event.target instanceof Element)) return;

		const selectedWindow = event.target.closest<HTMLElement>(selectableWindows);
		if (!selectedWindow) return;

		selectWindow(selectedWindow);
		syncWindowHash(selectedWindow);
	});

	document.addEventListener('click', (event) => {
		if (!(event.target instanceof Element)) return;

		const closeButton = event.target.closest<HTMLElement>('[data-window-close]');
		if (closeButton) {
			event.preventDefault();
			event.stopPropagation();
			const panel = closeButton.closest<HTMLElement>(selectableWindows);
			if (panel) closeWindow(panel);
			return;
		}

		const shortcut = event.target.closest<HTMLElement>('[data-window-shortcut]');
		if (!shortcut) return;

		event.preventDefault();
		const id = shortcut.dataset.windowTarget;
		if (!id) return;

		if (!desktopWindowQuery.matches || event instanceof MouseEvent && event.detail === 0) {
			activateWindow(id);
		} else {
			selectShortcut(shortcut);
		}
	});

	document.addEventListener('dblclick', (event) => {
		if (!desktopWindowQuery.matches || !(event.target instanceof Element)) return;

		const shortcut = event.target.closest<HTMLElement>('[data-window-shortcut]');
		if (!shortcut) return;

		event.preventDefault();
		const id = shortcut.dataset.windowTarget;
		if (id) activateWindow(id);
	});

	document.querySelectorAll<HTMLElement>(`${selectableWindows} > .mac-titlebar`).forEach((handle) => {
		handle.addEventListener('pointerdown', beginWindowDrag);
	});

	window.addEventListener('hashchange', syncSelectedWindow);
	desktopWindowQuery.addEventListener('change', syncAllShortcutStates);
	syncAllShortcutStates();
	syncSelectedWindow();
</script>
