---
/** Shared pixel icon for system navigation and Mac window title bars. */
interface Props {
	name: 'folder' | 'document' | 'profile' | 'github';
	size?: 'toolbar' | 'window' | 'desktop';
}

const { name, size = 'toolbar' } = Astro.props;
---

<span class:list={['module-icon', `module-icon--${name}`, `module-icon--${size}`]} aria-hidden="true">
	{name === 'github' ? (
		<svg viewBox="0 0 16 16" focusable="false">
			<path d="M8 0a8 8 0 0 0-2.53 15.59c.4.07.55-.17.55-.38v-1.49c-2.23.49-2.7-.94-2.7-.94-.36-.93-.89-1.18-.89-1.18-.73-.5.06-.49.06-.49.8.06 1.23.83 1.23.83.72 1.23 1.88.87 2.34.67.07-.52.28-.87.51-1.07-1.78-.2-3.65-.89-3.65-3.95 0-.87.31-1.59.83-2.15-.09-.2-.36-1.02.07-2.12 0 0 .68-.22 2.2.82A7.7 7.7 0 0 1 8 3.98c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.28.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48v2.19c0 .21.14.46.55.38A8 8 0 0 0 8 0Z"></path>
		</svg>
	) : (
		<i></i>
	)}
</span>

<style>
	.module-icon {
		position: relative;
		display: block;
		flex: none;
	}

	.module-icon--toolbar {
		width: 28px;
		height: 28px;
	}

	.module-icon--window {
		width: 16px;
		height: 16px;
	}

	.module-icon--desktop {
		width: 48px;
		height: 42px;
		filter: drop-shadow(3px 4px 0 rgb(21 23 29 / 28%));
	}

	.module-icon--folder i {
		position: absolute;
		border: 1px solid var(--ink);
		background: var(--accent-yellow);
	}

	.module-icon--folder i::before {
		position: absolute;
		border: 1px solid var(--ink);
		border-bottom: 0;
		background: var(--accent-yellow);
		content: '';
	}

	.module-icon--folder.module-icon--toolbar i {
		right: 0;
		bottom: 0;
		left: 0;
		height: 19px;
	}

	.module-icon--folder.module-icon--toolbar i::before {
		top: -7px;
		left: -2px;
		width: 13px;
		height: 7px;
	}

	.module-icon--folder.module-icon--window i {
		right: 1px;
		bottom: 1px;
		left: 1px;
		height: 10px;
	}

	.module-icon--folder.module-icon--window i::before {
		top: -4px;
		left: -1px;
		width: 7px;
		height: 4px;
	}

	.module-icon--folder.module-icon--desktop i {
		right: 1px;
		bottom: 1px;
		left: 1px;
		height: 28px;
	}

	.module-icon--folder.module-icon--desktop i::before {
		top: -10px;
		left: -1px;
		width: 21px;
		height: 10px;
	}

	.module-icon--document i {
		position: absolute;
		border: 1px solid var(--ink);
		background: var(--paper);
	}

	.module-icon--document i::before,
	.module-icon--document i::after {
		position: absolute;
		background: var(--ink);
		content: '';
	}

	.module-icon--document.module-icon--toolbar i {
		top: 0;
		left: 3px;
		width: 22px;
		height: 28px;
	}

	.module-icon--document.module-icon--toolbar i::before {
		top: 5px;
		right: 4px;
		left: 4px;
		height: 2px;
		box-shadow: 0 5px 0 var(--ink), 0 10px 0 var(--ink);
	}

	.module-icon--document.module-icon--toolbar i::after {
		top: 20px;
		right: 9px;
		left: 4px;
		height: 2px;
	}

	.module-icon--document.module-icon--window i {
		top: 1px;
		left: 3px;
		width: 10px;
		height: 14px;
	}

	.module-icon--document.module-icon--window i::before {
		top: 3px;
		right: 2px;
		left: 2px;
		height: 1px;
		box-shadow: 0 3px 0 var(--ink), 0 6px 0 var(--accent-cyan);
	}

	.module-icon--document.module-icon--window i::after {
		right: 4px;
		bottom: 1px;
		left: 2px;
		height: 1px;
	}

	.module-icon--document.module-icon--desktop i {
		top: 1px;
		left: 9px;
		width: 30px;
		height: 40px;
	}

	.module-icon--document.module-icon--desktop i::before {
		top: 8px;
		right: 5px;
		left: 5px;
		height: 2px;
		box-shadow: 0 7px 0 var(--ink), 0 14px 0 var(--accent-cyan);
	}

	.module-icon--document.module-icon--desktop i::after {
		right: 12px;
		bottom: 5px;
		left: 5px;
		height: 2px;
		background: var(--accent-coral);
	}

	.module-icon--profile i {
		position: absolute;
		border: 1px solid var(--ink);
		background: var(--paper);
	}

	.module-icon--profile i::before,
	.module-icon--profile i::after {
		position: absolute;
		background: var(--ink);
		content: '';
	}

	.module-icon--profile.module-icon--window i {
		inset: 1px;
	}

	.module-icon--profile.module-icon--window i::before {
		top: 2px;
		left: 4px;
		width: 4px;
		height: 4px;
	}

	.module-icon--profile.module-icon--window i::after {
		bottom: 2px;
		left: 2px;
		width: 8px;
		height: 4px;
	}

	.module-icon--profile.module-icon--desktop i {
		inset: 0 3px;
	}

	.module-icon--profile.module-icon--desktop i::before {
		top: 6px;
		left: 13px;
		width: 12px;
		height: 11px;
		clip-path: polygon(25% 0, 75% 0, 100% 25%, 100% 75%, 75% 100%, 25% 100%, 0 75%, 0 25%);
	}

	.module-icon--profile.module-icon--desktop i::after {
		bottom: 5px;
		left: 8px;
		width: 22px;
		height: 12px;
		clip-path: polygon(18% 0, 82% 0, 100% 40%, 100% 100%, 0 100%, 0 40%);
	}

	.module-icon--github.module-icon--toolbar {
		display: grid;
		border: 1px solid var(--ink);
		background: var(--paper);
		box-shadow: 2px 2px 0 var(--ink);
		place-items: center;
	}

	.module-icon--github svg {
		display: block;
		width: 18px;
		height: 18px;
		fill: var(--ink);
	}
</style>
