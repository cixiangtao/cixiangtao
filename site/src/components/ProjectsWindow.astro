---
import MacWindow from './MacWindow.astro';
import { getMessages, type Locale } from '../i18n';
import { formatDate, type Project } from '../lib/github';

interface Props {
	locale: Locale;
	projects: Project[];
}

const { locale, projects } = Astro.props;
const copy = getMessages(locale);
const colors = ['cyan', 'yellow', 'coral'] as const;

function getProjectColor(name: string) {
	const hash = [...name].reduce((total, character) => total + character.codePointAt(0)!, 0);
	return colors[hash % colors.length];
}
---

<MacWindow
	title={copy.sections.projects}
	icon="folder"
	id="projects"
	tone="yellow"
	scrollbars
	closeLabel={copy.window.close(copy.sections.projects)}
	minimizeLabel={copy.window.minimize(copy.sections.projects)}
	maximizeLabel={copy.window.maximize(copy.sections.projects)}
	restoreLabel={copy.window.restore(copy.sections.projects)}
	minWidth={480}
	minHeight={320}
	class="order-3 lg:absolute lg:right-[3%] lg:top-[13%] lg:z-30 lg:w-[44%]"
>
	<div class="project-toolbar flex items-center justify-between border-b border-[var(--ink)] bg-[var(--paper)] px-[13px] py-[9px] text-[0.7rem] font-extrabold max-[760px]:gap-2.5 max-[760px]:text-[0.64rem]">
		<div class="inline-flex items-center gap-[9px]"><span class="mini-folder" aria-hidden="true"></span><strong class="[font-family:var(--font-data)] text-[0.68rem] max-[760px]:text-[0.61rem]">cixiangtao / projects</strong></div>
		<a href="https://github.com/cixiangtao?tab=repositories" target="_blank" rel="noreferrer">{copy.projects.count(projects.length)}</a>
	</div>
	<ul class="project-list m-0 list-none p-2" aria-label={copy.projects.listLabel}>
		{projects.map((project) => (
			<li>
				<a class="grid grid-cols-[52px_minmax(0,1fr)_28px] items-center gap-[13px] px-[9px] py-[11px] max-[760px]:grid-cols-[44px_minmax(0,1fr)_22px]" href={project.href} target="_blank" rel="noreferrer" title={copy.projects.updated(formatDate(project.maintainedAt, locale))}>
					<span class:list={['project-icon', `project-icon--${getProjectColor(project.name)}`]} aria-hidden="true"><i></i></span>
					<span class="project-info block min-w-0">
						<strong>{project.name}</strong>
						<small>{project.description || copy.projects.noDescription}</small>
						<time datetime={project.maintainedAt}>{copy.projects.updated(formatDate(project.maintainedAt, locale))}</time>
					</span>
					<span class="project-actions inline-flex items-center justify-end gap-2" aria-hidden="true"><i>☆</i><b></b><em>↗</em></span>
				</a>
			</li>
		))}
	</ul>
	{projects.length === 0 && <p class="project-empty">{copy.projects.empty}</p>}
</MacWindow>

<style is:global>
	.project-toolbar a {
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.mini-folder {
		position: relative;
		display: block;
		width: 24px;
		height: 16px;
		margin-top: 3px;
		border: 1px solid var(--ink);
		background: var(--accent-yellow);
	}

	.mini-folder::before {
		position: absolute;
		top: -5px;
		left: -1px;
		width: 10px;
		height: 5px;
		border: 1px solid var(--ink);
		border-bottom: 0;
		background: var(--accent-yellow);
		content: "";
	}

	.project-list li + li {
		border-top: 1px solid var(--line-strong);
	}

	@media (min-width: 1024px) {
		#projects .mac-window-body {
			display: flex;
			min-height: 0;
			flex-direction: column;
		}

		.project-list {
			max-height: 430px;
			overflow-y: auto;
			scrollbar-width: none;
		}

		#projects[data-window-resized] .project-list {
			flex: 1;
			min-height: 0;
			max-height: none;
		}

		.project-list::-webkit-scrollbar {
			display: none;
		}
	}

	.project-list a:hover,
	.project-list a:focus-visible {
		background: var(--selection);
		color: white;
	}

	.project-empty {
		margin: 0;
		padding: 28px 18px;
		color: var(--muted);
		font-size: 0.72rem;
		font-weight: 750;
		text-align: center;
	}

	.project-icon {
		position: relative;
		display: grid;
		width: 48px;
		height: 42px;
		border: 1px solid var(--ink);
		background: var(--accent-cyan);
		box-shadow: inset -7px -7px 0 rgb(0 0 0 / 12%);
		place-items: center;
	}

	.project-icon::before,
	.project-icon::after,
	.project-icon i {
		position: absolute;
		background: var(--ink);
		content: "";
	}

	.project-icon::before {
		width: 19px;
		height: 3px;
		transform: rotate(45deg);
	}

	.project-icon::after {
		width: 19px;
		height: 3px;
		transform: rotate(-45deg);
	}

	.project-icon i {
		width: 3px;
		height: 25px;
	}

	.project-icon--yellow {
		background: var(--accent-yellow);
	}

	.project-icon--coral {
		background: var(--accent-coral);
	}

	.project-info strong,
	.project-info small,
	.project-info time {
		display: block;
	}

	.project-info strong {
		font-size: 0.86rem;
		font-weight: 900;
	}

	.project-info small {
		overflow: hidden;
		margin-top: 3px;
		color: var(--muted);
		font-size: 0.7rem;
		line-height: 1.45;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.project-info time {
		margin-top: 2px;
		color: var(--muted);
		font-family: var(--font-data);
		font-size: 0.58rem;
	}

	.project-list a:hover small,
	.project-list a:focus-visible small,
	.project-list a:hover time,
	.project-list a:focus-visible time {
		color: #eefcff;
	}

	.project-actions i,
	.project-actions em {
		font-size: 0.95rem;
		font-style: normal;
		font-weight: 900;
	}

	.project-actions b {
		position: relative;
		display: block;
		width: 12px;
		height: 15px;
		border: 1px solid currentColor;
	}

	.project-actions b::before,
	.project-actions b::after {
		position: absolute;
		right: 2px;
		left: 2px;
		height: 1px;
		background: currentColor;
		content: "";
	}

	.project-actions b::before {
		top: 4px;
	}

	.project-actions b::after {
		top: 8px;
	}

	@media (max-width: 760px) {
		.project-icon {
			width: 42px;
			height: 38px;
		}
	}
</style>
