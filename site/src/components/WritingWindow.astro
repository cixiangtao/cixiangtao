---
import type { BlogPost } from '../lib/github';
import { formatDate } from '../lib/github';
import { getLocalizedPath, getMessages, type Locale } from '../i18n';
import MacWindow from './MacWindow.astro';

/** Supplies the issue-backed article collection and deployment base path. */
interface Props {
	posts: BlogPost[];
	base: string;
	locale: Locale;
}

const { posts, base, locale } = Astro.props;
const copy = getMessages(locale);
---

<MacWindow
	title={copy.sections.writing}
	icon="document"
	id="writing"
	tone="cyan"
	scrollbars
	closeLabel={copy.window.close(copy.sections.writing)}
	minWidth={640}
	minHeight={480}
	class="order-2 lg:absolute lg:left-[18%] lg:top-[23%] lg:z-40 lg:h-[min(70%,600px)] lg:min-h-[480px] lg:w-[66%]"
>
	<div class="writing-toolbar flex items-center justify-between border-b border-[var(--ink)] bg-[var(--paper)] px-[13px] py-[9px] text-[0.72rem] font-extrabold max-[760px]:gap-2.5 max-[760px]:text-[0.64rem]">
		<div class="inline-flex items-center gap-2.5">
			<span class="mini-document" aria-hidden="true"></span>
			<strong class="[font-family:var(--font-data)] text-[0.68rem] max-[760px]:text-[0.61rem]">cixiangtao / writing</strong>
		</div>
		<span>{copy.writing.files(posts.length)}</span>
	</div>

	<div class="article-list flex flex-1 flex-col bg-[var(--paper)]" aria-labelledby="writing">
		{posts.slice(0, 5).map((post, index) => (
			<article class:list={['article-row', { 'article-row--featured': index === 0 }]}>
				<a class="grid grid-cols-[70px_minmax(0,1fr)_104px_52px] items-center gap-3.5 p-[15px] [transition:background_120ms_ease,color_120ms_ease] max-[760px]:grid-cols-[52px_minmax(0,1fr)] max-[760px]:gap-2.5 max-[760px]:px-3 max-[760px]:py-3.5" href={getLocalizedPath(base, locale, `posts/${post.number}/`)} aria-label={copy.writing.read(post.title)}>
					<span class="article-file-icon" aria-hidden="true"><i></i></span>
					<span class="article-copy">
						<span class="article-index">ISSUE {String(post.number).padStart(3, '0')}</span>
						<strong>{post.title}</strong>
						<small>{post.excerpt}</small>
					</span>
					<span class="article-meta max-[760px]:!hidden">
						<time datetime={post.createdAt}>{formatDate(post.createdAt, locale)}</time>
						<small>{copy.writing.minutes(post.readingMinutes)}</small>
					</span>
					<span class="article-open max-[760px]:hidden" aria-hidden="true">{copy.writing.open}</span>
				</a>
			</article>
		))}
	</div>

	{posts.length === 0 && (
		<div class="empty-state flex min-h-40 items-center justify-between p-7">
			<strong>{copy.writing.empty}</strong>
			<a href="https://github.com/cixiangtao/cixiangtao/issues">{copy.writing.openIssues}</a>
		</div>
	)}

	<div class="writing-footer flex items-center justify-between border-t border-[var(--ink)] bg-[var(--paper-soft)] px-[15px] py-[11px] text-[0.68rem] font-bold text-[var(--muted)] max-[760px]:flex-col max-[760px]:items-start max-[760px]:gap-[7px]">
		<span>{copy.writing.source}</span>
		<a href="https://github.com/cixiangtao/cixiangtao/issues?q=is%3Aissue%20label%3Ablog" target="_blank" rel="noreferrer">{copy.writing.archive}</a>
	</div>
</MacWindow>

<style is:global>
	.writing-footer a {
		color: var(--ink);
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.mini-document {
		position: relative;
		display: block;
		width: 18px;
		height: 22px;
		border: 1px solid var(--ink);
		background: var(--paper);
	}

	.mini-document::before {
		position: absolute;
		top: 5px;
		right: 3px;
		left: 3px;
		height: 1px;
		background: var(--ink);
		box-shadow: 0 4px 0 var(--ink), 0 8px 0 var(--accent-cyan);
		content: "";
	}

	.article-row--featured:only-child {
		display: flex;
		flex: 1;
	}

	.article-row--featured:only-child a {
		flex: 1;
	}

	#writing,
	#writing .mac-window-body {
		display: flex;
		flex-direction: column;
	}

	#writing .mac-window-content {
		flex: 1;
		min-height: 0;
	}

	#writing .mac-window-body {
		flex: 1;
		min-height: 0;
		overflow: hidden;
	}

	.article-row + .article-row {
		border-top: 1px solid var(--line-strong);
	}

	.article-row--featured a {
		min-height: 238px;
		background: var(--paper);
		color: var(--ink);
	}

	.article-row--featured .article-copy strong {
		font-size: clamp(1.25rem, 2.4vw, 1.75rem);
	}

	.article-row--featured .article-copy small {
		display: -webkit-box;
		overflow: hidden;
		max-width: 68ch;
		font-size: 0.8rem;
		line-height: 1.7;
		white-space: normal;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 3;
	}

	.article-row a:hover,
	.article-row a:focus-visible {
		background: var(--selection);
		color: white;
		outline: none;
	}

	.article-index {
		display: block;
		margin-bottom: 6px;
		color: var(--accent-blue-dark);
		font-family: var(--font-data);
		font-size: 0.64rem;
		font-weight: 900;
	}

	.article-file-icon {
		position: relative;
		display: block;
		width: 68px;
		height: 54px;
		border: 1px solid var(--ink);
		background:
			radial-gradient(var(--line-strong) 0.7px, transparent 0.7px),
			var(--accent-cyan);
		background-size: 3px 3px;
	}

	.article-file-icon i {
		position: absolute;
		top: 11px;
		left: 21px;
		width: 25px;
		height: 32px;
		border: 1px solid var(--ink);
		background: var(--paper);
	}

	.article-file-icon i::before {
		position: absolute;
		top: 8px;
		right: 4px;
		left: 4px;
		height: 2px;
		background: var(--ink);
		box-shadow: 0 6px 0 var(--ink), 0 12px 0 var(--accent-coral);
		content: "";
	}

	.article-copy,
	.article-copy strong,
	.article-copy small,
	.article-meta,
	.article-meta small {
		display: block;
		min-width: 0;
	}

	.article-copy strong {
		font-size: clamp(0.92rem, 1.8vw, 1.13rem);
		font-weight: 900;
		line-height: 1.35;
	}

	.article-copy small {
		overflow: hidden;
		margin-top: 5px;
		color: var(--muted);
		font-size: 0.72rem;
		line-height: 1.5;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.article-row a:hover .article-copy small,
	.article-row a:focus-visible .article-copy small,
	.article-row a:hover .article-meta,
	.article-row a:focus-visible .article-meta,
	.article-row a:hover .article-index,
	.article-row a:focus-visible .article-index {
		color: white;
	}

	.article-meta {
		color: var(--muted);
		font-size: 0.66rem;
		line-height: 1.5;
		text-align: right;
	}

	.article-meta small {
		margin-top: 3px;
	}

	.article-open {
		padding: 7px 9px;
		border: 1px dashed currentColor;
		font-family: var(--font-data);
		font-size: 0.64rem;
		font-weight: 900;
		text-align: center;
	}

	@media (max-width: 760px) {
		.article-row--featured a {
			min-height: 150px;
		}

		.article-file-icon {
			width: 50px;
			height: 42px;
		}

		.article-file-icon i {
			top: 7px;
			left: 16px;
			width: 19px;
			height: 27px;
		}

		.article-file-icon i::before {
			top: 7px;
			height: 1px;
			box-shadow: 0 5px 0 var(--ink), 0 10px 0 var(--accent-coral);
		}
	}

	@media (min-width: 1024px) {
		#writing .article-list {
			min-height: 0;
			overflow-y: auto;
			scrollbar-width: none;
		}

		#writing .article-list::-webkit-scrollbar {
			display: none;
		}
	}
</style>
