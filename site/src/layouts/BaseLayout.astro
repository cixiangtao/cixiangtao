---
import '../styles/global.css';
import ModuleIcon from '../components/ModuleIcon.astro';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'cixiangtao 的个人工作台',
	description = '慈祥涛的个人主页、开源作品集与中文技术博客。',
} = Astro.props;
const pageTitle = title === 'cixiangtao 的个人工作台' ? title : `${title} · cixiangtao`;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#6670c9" />
		<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
		<title>{pageTitle}</title>
	</head>
	<body class="flex min-h-svh min-w-80 flex-col antialiased">
		<header class="system-bar">
			<div class="system-context-group">
				<nav class="system-home" aria-label="主页">
					<a class="system-tool system-tool--avatar" href={base} aria-label="首页" data-label="首页" data-nav="home">
						<img src="https://github.com/cixiangtao.png?size=64" alt="" width="32" height="32" decoding="async" />
					</a>
				</nav>
				<span class="system-separator" aria-hidden="true"></span>
				<span class="system-context">当前位置：<strong data-nav-context aria-live="polite">首页</strong></span>
			</div>

			<div class="system-actions">
				<nav class="system-external" aria-label="外部链接">
					<a class="system-tool" href="https://github.com/cixiangtao" target="_blank" rel="noreferrer" aria-label="在新窗口打开 GitHub" data-label="GitHub"><ModuleIcon name="github" /></a>
				</nav>
				<span class="system-separator" aria-hidden="true"></span>
				<div class="system-status" aria-label="系统状态">
					<span class="system-presence"><span class="status-dot" aria-hidden="true"></span>在线</span>
				</div>
			</div>
		</header>

		<main class="flex flex-1 flex-col">
			<slot />
		</main>

		<footer class="site-footer">
			<p>持续好奇，认真交付。</p>
			<p>内容来自 GitHub Issues，由 Astro 构建。</p>
		</footer>

		<script>
			const navigationLabels = {
				home: '首页',
				projects: '代表项目',
				writing: '最近文章',
				about: '关于我',
			} as const;
			type NavigationKey = keyof typeof navigationLabels;

			function resolveNavigationKey(): NavigationKey {
				if (window.location.pathname.includes('/posts/')) return 'writing';

				const hash = window.location.hash.slice(1);
				return hash in navigationLabels ? (hash as NavigationKey) : 'home';
			}

			function syncInternalNavigation(key = resolveNavigationKey()) {
				document.querySelectorAll<HTMLElement>('[data-nav]').forEach((link) => {
					if (link.dataset.nav === key) {
						link.setAttribute('aria-current', 'page');
					} else {
						link.removeAttribute('aria-current');
					}
				});

				const context = document.querySelector<HTMLElement>('[data-nav-context]');
				if (context) context.textContent = navigationLabels[key];
			}

			window.addEventListener('hashchange', () => syncInternalNavigation());
			window.addEventListener('workspace:navigate', (event) => {
				const id = event instanceof CustomEvent ? event.detail?.id : null;
				syncInternalNavigation(
					typeof id === 'string' && id in navigationLabels ? (id as NavigationKey) : resolveNavigationKey(),
				);
			});
			syncInternalNavigation();
		</script>
	</body>
</html>
