---
import '../styles/global.css';
import ContextMenu from '../components/ContextMenu.astro';
import ModuleIcon from '../components/ModuleIcon.astro';
import { defaultLocale, getAlternateLocale, getLocalizedPath, getMessages, type Locale } from '../i18n';
import { wallpaperIds, wallpaperThemeColors } from '../wallpapers';

interface Props {
	title?: string;
	description?: string;
	locale?: Locale;
	alternateHref: string;
}

const {
	title,
	description,
	locale = defaultLocale,
	alternateHref,
} = Astro.props;
const copy = getMessages(locale);
const alternateLocale = getAlternateLocale(locale);
const pageTitle = title ? `${title} · cixiangtao` : copy.site.title;
const pageDescription = description ?? copy.site.description;
const base = import.meta.env.BASE_URL;
const homeHref = getLocalizedPath(base, locale);
const currentAbsoluteUrl = new URL(Astro.url.pathname, Astro.site);
const alternateAbsoluteUrl = new URL(alternateHref, Astro.site);
const defaultAbsoluteUrl = locale === defaultLocale ? currentAbsoluteUrl : alternateAbsoluteUrl;
const wallpaperOptions = wallpaperIds.map((id) => ({ id, label: copy.wallpaper.names[id] }));
---

<!doctype html>

<html
	lang={copy.htmlLang}
	data-wallpaper-ids={wallpaperIds.join(',')}
	data-wallpaper-theme-colors={JSON.stringify(wallpaperThemeColors)}
>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={pageDescription} />
		<meta name="theme-color" content="#6670c9" />
		<script is:inline>
			(() => {
				const root = document.documentElement;
				const availableWallpapers = root.dataset.wallpaperIds?.split(',') ?? [];
				const themeColors = JSON.parse(root.dataset.wallpaperThemeColors ?? '{}');
				let wallpaper = 'classic';

				try {
					const storedWallpaper = window.localStorage.getItem('cixiangtao-wallpaper');
					if (storedWallpaper && availableWallpapers.includes(storedWallpaper)) wallpaper = storedWallpaper;
				} catch {
					// Keep the default wallpaper when storage is unavailable.
				}

				root.dataset.wallpaper = wallpaper;
				root.removeAttribute('data-wallpaper-ids');
				root.removeAttribute('data-wallpaper-theme-colors');
				document.querySelector('meta[name="theme-color"]')?.setAttribute('content', themeColors[wallpaper]);
			})();
		</script>
		<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
		<link rel="canonical" href={currentAbsoluteUrl} />
		<link rel="alternate" hreflang={locale} href={currentAbsoluteUrl} />
		<link rel="alternate" hreflang={alternateLocale} href={alternateAbsoluteUrl} />
		<link rel="alternate" hreflang="x-default" href={defaultAbsoluteUrl} />
		<title>{pageTitle}</title>
	</head>
	<body
		class="flex min-h-svh min-w-80 flex-col antialiased"
		data-nav-about={copy.sections.about}
		data-nav-home={copy.sections.home}
		data-nav-projects={copy.sections.projects}
		data-nav-writing={copy.sections.writing}
	>
		<header class="system-bar w-full">
			<div class="system-context-group">
				<nav class="system-home" aria-label={copy.sections.home}>
					<a class="system-tool system-tool--avatar" href={homeHref} aria-label={copy.sections.home} data-label={copy.sections.home} data-nav="home">
						<img src="https://github.com/cixiangtao.png?size=64" alt="" width="32" height="32" decoding="async" />
					</a>
				</nav>
				<span class="system-separator" aria-hidden="true"></span>
				<span class="system-context">{copy.nav.location}<strong data-nav-context aria-live="polite">{copy.sections.home}</strong></span>
			</div>

			<div class="system-actions">
				<nav class="system-external" aria-label={copy.nav.externalLinks}>
					<button
						class="system-tool system-wallpaper-button"
						type="button"
						aria-controls="desktop-context-menu"
						aria-haspopup="menu"
						aria-label={copy.wallpaper.openMenu}
						data-label={`${copy.wallpaper.current} ${copy.wallpaper.names.classic}`}
						data-wallpaper-changed={copy.wallpaper.changed}
						data-wallpaper-current={copy.wallpaper.current}
						data-wallpaper-open-menu={copy.wallpaper.openMenu}
						data-wallpaper-toggle
					>
						<span class="wallpaper-swatch" aria-hidden="true"></span>
					</button>
					<span class="sr-only" aria-live="polite" data-wallpaper-announcer></span>
					<label class="sr-only" for="system-language">{copy.nav.languageLabel}</label>
					<span class="system-language-picker">
						<select
							id="system-language"
							class="system-language-select"
							aria-label={copy.nav.languageLabel}
							autocomplete="off"
							data-language-select
							title={copy.nav.languageLabel}
						>
							<option data-locale="en" lang="en" value={locale === 'en' ? Astro.url.pathname : alternateHref} selected={locale === 'en'}>English</option>
							<option data-locale="zh" lang="zh-CN" value={locale === 'zh' ? Astro.url.pathname : alternateHref} selected={locale === 'zh'}>中文</option>
						</select>
					</span>
					<a class="system-tool" href="https://github.com/cixiangtao" target="_blank" rel="noreferrer" aria-label={copy.nav.openGitHub} data-label="GitHub"><ModuleIcon name="github" /></a>
				</nav>
				<span class="system-separator" aria-hidden="true"></span>
				<div class="system-status" aria-label={copy.nav.systemStatus}>
					<span class="system-presence"><span class="status-dot" aria-hidden="true"></span>{copy.nav.online}</span>
				</div>
			</div>
		</header>

		<ContextMenu id="desktop-context-menu" label={copy.wallpaper.menuLabel}>
			<button
				class="context-menu-item"
				type="button"
				role="menuitem"
				aria-controls="desktop-skin-menu"
				aria-expanded="false"
				aria-haspopup="menu"
			>
				<span>{copy.wallpaper.skin}</span>
				<span class="context-menu-arrow" aria-hidden="true">▶</span>
			</button>
			<div id="desktop-skin-menu" class="context-submenu" role="menu" aria-label={copy.wallpaper.skin} data-context-submenu hidden>
				{
					wallpaperOptions.map((option) => (
						<button
							class="context-menu-item"
							type="button"
							role="menuitemradio"
							aria-checked="false"
							data-wallpaper-name={option.label}
							data-wallpaper-option={option.id}
						>
							<span class="context-menu-check" aria-hidden="true">✓</span>
							<span>{option.label}</span>
						</button>
					))
				}
			</div>
		</ContextMenu>

		<main class="flex w-full flex-1 flex-col">
			<slot />
		</main>

		<footer class="site-footer w-full">
			<p>{copy.footer.motto}</p>
			<p>{copy.footer.source}</p>
		</footer>

		<script>
			import { wallpaperIds, wallpaperThemeColors, type Wallpaper } from '../wallpapers';

			const languageCacheParam = '_language';
			const currentUrl = new URL(window.location.href);
			if (currentUrl.searchParams.has(languageCacheParam)) {
				currentUrl.searchParams.delete(languageCacheParam);
				window.history.replaceState(window.history.state, '', currentUrl);
			}

			const languageSelect = document.querySelector<HTMLSelectElement>('[data-language-select]');
			languageSelect?.addEventListener('change', () => {
				const destination = new URL(languageSelect.value, window.location.href);
				destination.search = window.location.search;
				const selectedLocale = languageSelect.selectedOptions[0]?.dataset.locale ?? 'en';
				destination.searchParams.set(languageCacheParam, `${selectedLocale}-${Date.now()}`);
				destination.hash = window.location.hash;
				window.location.assign(destination);
			});

			const wallpaperButton = document.querySelector<HTMLButtonElement>('[data-wallpaper-toggle]');
			const wallpaperAnnouncer = document.querySelector<HTMLElement>('[data-wallpaper-announcer]');
			const wallpaperOptionButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-wallpaper-option]'));
			const themeColor = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
			const desktopMedia = window.matchMedia('(min-width: 1024px)');
			const wallpaperNames = Object.fromEntries(
				wallpaperOptionButtons.map((button) => [button.dataset.wallpaperOption, button.dataset.wallpaperName]),
			) as Record<Wallpaper, string>;

			function getCurrentWallpaper(): Wallpaper {
				const wallpaper = document.documentElement.dataset.wallpaper;
				return wallpaperIds.includes(wallpaper as Wallpaper) ? (wallpaper as Wallpaper) : 'classic';
			}

			function applyWallpaper(wallpaper: Wallpaper, announce = false) {
				document.documentElement.dataset.wallpaper = wallpaper;
				themeColor?.setAttribute('content', wallpaperThemeColors[wallpaper]);
				const currentName = wallpaperNames[wallpaper];

				if (wallpaperButton) {
					wallpaperButton.dataset.label = `${wallpaperButton.dataset.wallpaperCurrent} ${currentName}`;
					wallpaperButton.title = `${wallpaperButton.dataset.label}`;
					wallpaperButton.setAttribute('aria-label', wallpaperButton.dataset.wallpaperOpenMenu ?? 'Open desktop menu');
				}
				wallpaperOptionButtons.forEach((button) => {
					button.setAttribute('aria-checked', String(button.dataset.wallpaperOption === wallpaper));
				});

				if (announce && wallpaperAnnouncer) {
					wallpaperAnnouncer.textContent = `${wallpaperButton?.dataset.wallpaperChanged} ${currentName}`;
				}
			}

			function openDesktopMenu(x: number, y: number, returnFocus?: HTMLElement | null) {
				if (!desktopMedia.matches) return;
				document.dispatchEvent(
					new CustomEvent('context-menu:open', {
						detail: { id: 'desktop-context-menu', x, y, returnFocus },
					}),
				);
			}

			wallpaperButton?.addEventListener('click', () => {
				const bounds = wallpaperButton.getBoundingClientRect();
				openDesktopMenu(bounds.left, bounds.bottom + 6, wallpaperButton);
			});

			wallpaperOptionButtons.forEach((button) => {
				button.addEventListener('click', () => {
					const wallpaper = button.dataset.wallpaperOption as Wallpaper;
					if (!wallpaperIds.includes(wallpaper)) return;

					try {
						window.localStorage.setItem('cixiangtao-wallpaper', wallpaper);
					} catch {
						// The in-memory selection still works when storage is unavailable.
					}

					applyWallpaper(wallpaper, true);
				});
			});

			document.addEventListener('contextmenu', (event) => {
				if (!desktopMedia.matches || !(event.target instanceof HTMLElement)) return;
				const stage = event.target.closest<HTMLElement>('.desktop-stage');
				if (!stage) return;
				if (event.target.closest('.mac-window, .desktop-icons, a, button, input, select, textarea, [contenteditable]')) return;

				event.preventDefault();
				openDesktopMenu(event.clientX, event.clientY);
			});
			applyWallpaper(getCurrentWallpaper());

			const body = document.body;
			const navigationLabels = {
				home: body.dataset.navHome ?? 'Home',
				projects: body.dataset.navProjects ?? 'Projects',
				writing: body.dataset.navWriting ?? 'Writing',
				about: body.dataset.navAbout ?? 'About',
			} as const;
			type NavigationKey = keyof typeof navigationLabels;

			function resolveNavigationKey(): NavigationKey {
				if (window.location.pathname.includes('/posts/')) return 'writing';

				const hash = window.location.hash.slice(1);
				return hash in navigationLabels ? (hash as NavigationKey) : 'home';
			}

			function syncInternalNavigation(key = resolveNavigationKey()) {
				document.querySelectorAll<HTMLElement>('[data-nav]').forEach((link) => {
					if (link.dataset.nav === key) {
						link.setAttribute('aria-current', 'page');
					} else {
						link.removeAttribute('aria-current');
					}
				});

				const context = document.querySelector<HTMLElement>('[data-nav-context]');
				if (context) context.textContent = navigationLabels[key];
			}

			window.addEventListener('hashchange', () => syncInternalNavigation());
			window.addEventListener('workspace:navigate', (event) => {
				const id = event instanceof CustomEvent ? event.detail?.id : null;
				syncInternalNavigation(
					typeof id === 'string' && id in navigationLabels ? (id as NavigationKey) : resolveNavigationKey(),
				);
			});
			syncInternalNavigation();
		</script>
	</body>
</html>
