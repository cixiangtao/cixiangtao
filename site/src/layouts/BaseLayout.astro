---
import '../styles/global.css';
import ModuleIcon from '../components/ModuleIcon.astro';
import { defaultLocale, getAlternateLocale, getLocalizedPath, getMessages, type Locale } from '../i18n';

interface Props {
	title?: string;
	description?: string;
	locale?: Locale;
	alternateHref: string;
}

const {
	title,
	description,
	locale = defaultLocale,
	alternateHref,
} = Astro.props;
const copy = getMessages(locale);
const alternateLocale = getAlternateLocale(locale);
const pageTitle = title ? `${title} · cixiangtao` : copy.site.title;
const pageDescription = description ?? copy.site.description;
const base = import.meta.env.BASE_URL;
const homeHref = getLocalizedPath(base, locale);
const currentAbsoluteUrl = new URL(Astro.url.pathname, Astro.site);
const alternateAbsoluteUrl = new URL(alternateHref, Astro.site);
const defaultAbsoluteUrl = locale === defaultLocale ? currentAbsoluteUrl : alternateAbsoluteUrl;
---

<!doctype html>

<html lang={copy.htmlLang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={pageDescription} />
		<meta name="theme-color" content="#6670c9" />
		<script is:inline>
			(() => {
				const wallpapers = ['classic', 'aqua', 'midnight'];
				const themeColors = {
					classic: '#6670c9',
					aqua: '#1f7f8b',
					midnight: '#152047',
				};
				let wallpaper = 'classic';

				try {
					const storedWallpaper = window.localStorage.getItem('cixiangtao-wallpaper');
					if (wallpapers.includes(storedWallpaper)) wallpaper = storedWallpaper;
				} catch {
					// Keep the default wallpaper when storage is unavailable.
				}

				document.documentElement.dataset.wallpaper = wallpaper;
				document.querySelector('meta[name="theme-color"]')?.setAttribute('content', themeColors[wallpaper]);
			})();
		</script>
		<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
		<link rel="canonical" href={currentAbsoluteUrl} />
		<link rel="alternate" hreflang={locale} href={currentAbsoluteUrl} />
		<link rel="alternate" hreflang={alternateLocale} href={alternateAbsoluteUrl} />
		<link rel="alternate" hreflang="x-default" href={defaultAbsoluteUrl} />
		<title>{pageTitle}</title>
	</head>
	<body
		class="flex min-h-svh min-w-80 flex-col antialiased"
		data-nav-about={copy.nav.about}
		data-nav-home={copy.nav.home}
		data-nav-projects={copy.nav.projects}
		data-nav-writing={copy.nav.writing}
	>
		<header class="system-bar">
			<div class="system-context-group">
				<nav class="system-home" aria-label={copy.nav.homeNav}>
					<a class="system-tool system-tool--avatar" href={homeHref} aria-label={copy.nav.home} data-label={copy.nav.home} data-nav="home">
						<img src="https://github.com/cixiangtao.png?size=64" alt="" width="32" height="32" decoding="async" />
					</a>
				</nav>
				<span class="system-separator" aria-hidden="true"></span>
				<span class="system-context">{copy.nav.location}<strong data-nav-context aria-live="polite">{copy.nav.home}</strong></span>
			</div>

			<div class="system-actions">
				<nav class="system-external" aria-label={copy.nav.externalLinks}>
					<button
						class="system-tool system-wallpaper-button"
						type="button"
						aria-label={`${copy.wallpaper.switchTo} ${copy.wallpaper.names.aqua}`}
						data-label={`${copy.wallpaper.current} ${copy.wallpaper.names.classic}`}
						data-wallpaper-aqua={copy.wallpaper.names.aqua}
						data-wallpaper-changed={copy.wallpaper.changed}
						data-wallpaper-classic={copy.wallpaper.names.classic}
						data-wallpaper-current={copy.wallpaper.current}
						data-wallpaper-midnight={copy.wallpaper.names.midnight}
						data-wallpaper-switch={copy.wallpaper.switchTo}
						data-wallpaper-toggle
					>
						<span class="wallpaper-swatch" aria-hidden="true"></span>
					</button>
					<span class="sr-only" aria-live="polite" data-wallpaper-announcer></span>
					<label class="sr-only" for="system-language">{copy.nav.languageLabel}</label>
					<span class="system-language-picker">
						<select
							id="system-language"
							class="system-language-select"
							aria-label={copy.nav.languageLabel}
							autocomplete="off"
							data-language-select
							title={copy.nav.languageLabel}
						>
							<option lang="en" value={locale === 'en' ? Astro.url.pathname : alternateHref} selected={locale === 'en'}>English</option>
							<option lang="zh-CN" value={locale === 'zh' ? Astro.url.pathname : alternateHref} selected={locale === 'zh'}>中文</option>
						</select>
					</span>
					<a class="system-tool" href="https://github.com/cixiangtao" target="_blank" rel="noreferrer" aria-label={copy.nav.openGitHub} data-label="GitHub"><ModuleIcon name="github" /></a>
				</nav>
				<span class="system-separator" aria-hidden="true"></span>
				<div class="system-status" aria-label={copy.nav.systemStatus}>
					<span class="system-presence"><span class="status-dot" aria-hidden="true"></span>{copy.nav.online}</span>
				</div>
			</div>
		</header>

		<main class="flex flex-1 flex-col">
			<slot />
		</main>

		<footer class="site-footer">
			<p>{copy.footer.motto}</p>
			<p>{copy.footer.source}</p>
		</footer>

		<script>
			const languageSelect = document.querySelector<HTMLSelectElement>('[data-language-select]');
			languageSelect?.addEventListener('change', () => {
				const destination = new URL(languageSelect.value, window.location.href);
				destination.search = window.location.search;
				destination.hash = window.location.hash;
				window.location.assign(destination);
			});

			const wallpapers = ['classic', 'aqua', 'midnight'] as const;
			type Wallpaper = (typeof wallpapers)[number];
			const wallpaperButton = document.querySelector<HTMLButtonElement>('[data-wallpaper-toggle]');
			const wallpaperAnnouncer = document.querySelector<HTMLElement>('[data-wallpaper-announcer]');
			const themeColor = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
			const wallpaperNames: Record<Wallpaper, string> = {
				classic: wallpaperButton?.dataset.wallpaperClassic ?? 'Classic',
				aqua: wallpaperButton?.dataset.wallpaperAqua ?? 'Aqua',
				midnight: wallpaperButton?.dataset.wallpaperMidnight ?? 'Midnight',
			};
			const themeColors: Record<Wallpaper, string> = {
				classic: '#6670c9',
				aqua: '#1f7f8b',
				midnight: '#152047',
			};

			function getCurrentWallpaper(): Wallpaper {
				const wallpaper = document.documentElement.dataset.wallpaper;
				return wallpapers.includes(wallpaper as Wallpaper) ? (wallpaper as Wallpaper) : 'classic';
			}

			function applyWallpaper(wallpaper: Wallpaper, announce = false) {
				document.documentElement.dataset.wallpaper = wallpaper;
				themeColor?.setAttribute('content', themeColors[wallpaper]);

				const index = wallpapers.indexOf(wallpaper);
				const nextWallpaper = wallpapers[(index + 1) % wallpapers.length];
				const currentName = wallpaperNames[wallpaper];
				const nextName = wallpaperNames[nextWallpaper];

				if (wallpaperButton) {
					wallpaperButton.dataset.label = `${wallpaperButton.dataset.wallpaperCurrent} ${currentName}`;
					wallpaperButton.title = `${wallpaperButton.dataset.wallpaperCurrent} ${currentName}`;
					wallpaperButton.setAttribute('aria-label', `${wallpaperButton.dataset.wallpaperSwitch} ${nextName}`);
				}

				if (announce && wallpaperAnnouncer) {
					wallpaperAnnouncer.textContent = `${wallpaperButton?.dataset.wallpaperChanged} ${currentName}`;
				}
			}

			wallpaperButton?.addEventListener('click', () => {
				const currentWallpaper = getCurrentWallpaper();
				const nextWallpaper = wallpapers[(wallpapers.indexOf(currentWallpaper) + 1) % wallpapers.length];

				try {
					window.localStorage.setItem('cixiangtao-wallpaper', nextWallpaper);
				} catch {
					// The in-memory selection still works when storage is unavailable.
				}

				applyWallpaper(nextWallpaper, true);
			});
			applyWallpaper(getCurrentWallpaper());

			const body = document.body;
			const navigationLabels = {
				home: body.dataset.navHome ?? 'Home',
				projects: body.dataset.navProjects ?? 'Projects',
				writing: body.dataset.navWriting ?? 'Latest writing',
				about: body.dataset.navAbout ?? 'About me',
			} as const;
			type NavigationKey = keyof typeof navigationLabels;

			function resolveNavigationKey(): NavigationKey {
				if (window.location.pathname.includes('/posts/')) return 'writing';

				const hash = window.location.hash.slice(1);
				return hash in navigationLabels ? (hash as NavigationKey) : 'home';
			}

			function syncInternalNavigation(key = resolveNavigationKey()) {
				document.querySelectorAll<HTMLElement>('[data-nav]').forEach((link) => {
					if (link.dataset.nav === key) {
						link.setAttribute('aria-current', 'page');
					} else {
						link.removeAttribute('aria-current');
					}
				});

				const context = document.querySelector<HTMLElement>('[data-nav-context]');
				if (context) context.textContent = navigationLabels[key];
			}

			window.addEventListener('hashchange', () => syncInternalNavigation());
			window.addEventListener('workspace:navigate', (event) => {
				const id = event instanceof CustomEvent ? event.detail?.id : null;
				syncInternalNavigation(
					typeof id === 'string' && id in navigationLabels ? (id as NavigationKey) : resolveNavigationKey(),
				);
			});
			syncInternalNavigation();
		</script>
	</body>
</html>
