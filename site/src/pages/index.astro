---
import MacWindow from '../components/MacWindow.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatDate, getBlogPosts } from '../lib/github';

const posts = await getBlogPosts();
const base = import.meta.env.BASE_URL;

const projects = [
	{
		name: 'codex-skin',
		description: '为 macOS 上的 Codex 桌面端提供主题与界面定制。',
		href: 'https://github.com/cixiangtao/codex-skin',
		color: 'cyan',
	},
	{
		name: 'vite-plugin-locator',
		description: '一行配置，为 Vite 5–8 接入 LocatorJS。',
		href: 'https://github.com/cixiangtao/vite-plugin-locator',
		color: 'yellow',
	},
	{
		name: 'sticker-ui',
		description: '手册贴纸风格的 React 与 Tailwind CSS 组件库。',
		href: 'https://github.com/cixiangtao/sticker-ui',
		color: 'coral',
	},
];
---

<!--
THESIS: 把个人网站变成一台持续工作的彩色桌面，拒绝普通博客的纵向栏目与卡片陈列。
OWN-WORLD: 经典 Mac 窗口、像素图形、紫蓝桌面，以及青黄珊瑚色的功能状态共同构成界面。
STORY: 访客先看见最近写作，再确认代表项目与作者身份，并进入文章或 GitHub 继续阅读。
FIRST VIEWPORT: 最大的文章窗口位于前景，项目窗口居右后方，关于我缩在左上；主导航固定在菜单栏。
FORM: 有明确主次的多窗口桌面，沿用用户选中的方案三构图，并融合像素色彩与技术档案排版；seed 7348d99a。
FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
-->

<BaseLayout>
	<section class="desktop-stage relative mx-auto flex w-full max-w-[1480px] flex-col gap-5 px-4 py-6 sm:px-6 lg:block lg:min-h-[850px] lg:px-8 lg:py-8" aria-label="cixiangtao 的个人工作台">
		<div class="desktop-icons" aria-label="快捷入口">
			<a href="https://github.com/cixiangtao" target="_blank" rel="noreferrer">
				<span class="desktop-icon desktop-icon--computer" aria-hidden="true"><i></i></span>
				GitHub
			</a>
			<a href="#writing">
				<span class="desktop-icon desktop-icon--document" aria-hidden="true"><i></i></span>
				文章
			</a>
		</div>

		<MacWindow
			title="关于我"
			id="about"
		class="order-1 lg:absolute lg:left-[7%] lg:top-[7%] lg:z-20 lg:w-[34%]"
		>
			<div class="about-panel">
				<a class="pixel-avatar" href="https://github.com/cixiangtao" target="_blank" rel="noreferrer" aria-label="打开 cixiangtao 的 GitHub 主页">
					<img src="https://github.com/cixiangtao.png?size=176" alt="cixiangtao 的 GitHub 头像" width="176" height="176" decoding="async" fetchpriority="high" />
				</a>
				<div class="min-w-0">
					<h1>cixiangtao</h1>
					<p class="about-role">开源项目 · 技术写作</p>
					<p class="about-copy">持续构建开源项目，也把实践过程整理成可以复用的工具和文章。</p>
				</div>
			</div>
			<div class="about-status">
				<nav class="about-shortcuts" aria-label="公开入口">
					<a href="https://github.com/cixiangtao" target="_blank" rel="noreferrer" aria-label="GitHub"><i class="shortcut-icon shortcut-icon--github" aria-hidden="true"></i></a>
					<span aria-hidden="true"></span>
					<a href="#projects" aria-label="代表项目"><i class="shortcut-icon shortcut-icon--folder" aria-hidden="true"></i></a>
					<span aria-hidden="true"></span>
					<a href="#writing" aria-label="最近文章"><i class="shortcut-icon shortcut-icon--mail" aria-hidden="true"></i></a>
				</nav>
				<span><i class="status-dot" aria-hidden="true"></i>持续构建</span>
			</div>
		</MacWindow>

		<MacWindow
			title="代表项目"
			id="projects"
			tone="yellow"
			scrollbars
		class="order-3 lg:absolute lg:right-[4%] lg:top-[14%] lg:z-30 lg:w-[46%]"
		>
			<div class="project-toolbar">
				<div><span class="mini-folder" aria-hidden="true"></span><strong>cixiangtao / projects</strong></div>
				<a href="https://github.com/cixiangtao?tab=repositories" target="_blank" rel="noreferrer">{projects.length} 项 · 全部打开 ↗</a>
			</div>
			<ul class="project-list">
				{projects.map((project) => (
					<li>
						<a href={project.href} target="_blank" rel="noreferrer">
							<span class:list={['project-icon', `project-icon--${project.color}`]} aria-hidden="true"><i></i></span>
							<span class="project-info">
								<strong>{project.name}</strong>
								<small>{project.description}</small>
							</span>
							<span class="project-actions" aria-hidden="true"><i>☆</i><b></b><em>↗</em></span>
						</a>
					</li>
				))}
			</ul>
		</MacWindow>

		<MacWindow
			title="最近文章"
			id="writing"
			tone="cyan"
			scrollbars
		class="order-2 lg:absolute lg:bottom-[7%] lg:left-[12%] lg:z-40 lg:min-h-[470px] lg:w-[72%]"
		>
			<div class="writing-toolbar">
				<div>
					<span class="mini-document" aria-hidden="true"></span>
					<strong>cixiangtao / writing</strong>
				</div>
				<span>{posts.length} 个文件</span>
			</div>

			<div class="article-list" aria-labelledby="writing">
				{posts.slice(0, 5).map((post, index) => (
					<article class:list={['article-row', { 'article-row--featured': index === 0 }]}>
						<a href={`${base}posts/${post.number}/`} aria-label={`阅读：${post.title}`}>
							<span class="article-file-icon" aria-hidden="true"><i></i></span>
							<span class="article-copy">
								<span class="article-index">ISSUE {String(post.number).padStart(3, '0')}</span>
								<strong>{post.title}</strong>
								<small>{post.excerpt}</small>
							</span>
							<span class="article-meta">
								<time datetime={post.createdAt}>{formatDate(post.createdAt)}</time>
								<small>{post.readingMinutes} 分钟</small>
							</span>
							<span class="article-open" aria-hidden="true">打开</span>
						</a>
					</article>
				))}
			</div>

			{posts.length === 0 && (
				<div class="empty-state">
					<strong>文章文件夹暂时为空。</strong>
					<a href="https://github.com/cixiangtao/cixiangtao/issues">前往 GitHub Issues ↗</a>
				</div>
			)}

			<div class="writing-footer">
				<span>文章源自带有 blog 标签的 GitHub Issues</span>
				<a href="https://github.com/cixiangtao/cixiangtao/issues?q=is%3Aissue%20label%3Ablog" target="_blank" rel="noreferrer">打开文章档案 ↗</a>
			</div>
		</MacWindow>
	</section>
</BaseLayout>

<style is:global>
	.desktop-icons {
		display: none;
	}

	.about-panel {
		display: grid;
		grid-template-columns: 88px minmax(0, 1fr);
		gap: 18px;
		align-items: center;
		padding: 22px;
	}

	.pixel-avatar {
		position: relative;
		display: block;
		overflow: hidden;
		width: 88px;
		aspect-ratio: 1;
		padding: 6px;
		border: 1px dashed var(--ink);
		background:
			radial-gradient(var(--line-strong) 0.7px, transparent 0.7px),
			var(--accent-yellow);
		background-size: 3px 3px;
	}

	.pixel-avatar::after {
		position: absolute;
		top: 6px;
		right: 6px;
		width: 11px;
		height: 11px;
		background: var(--accent-cyan);
		box-shadow: -11px 11px 0 var(--ink);
		content: "";
	}

	.pixel-avatar img {
		display: block;
		width: 100%;
		height: 100%;
		border: 1px solid var(--ink);
		object-fit: cover;
	}

	.about-panel h1 {
		margin: 0;
		font-family: var(--font-data);
		font-size: clamp(1.45rem, 2.5vw, 2rem);
		font-weight: 900;
		letter-spacing: -0.03em;
	}

	.about-role {
		margin: 5px 0 12px;
		color: var(--accent-blue-dark);
		font-size: 0.78rem;
		font-weight: 800;
	}

	.about-copy {
		margin: 0;
		color: var(--muted);
		font-size: 0.82rem;
		line-height: 1.65;
	}

	.about-status {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 9px 16px;
		border-top: 1px solid var(--ink);
		background: var(--paper);
		font-size: 0.72rem;
		font-weight: 750;
	}

	.about-status > span,
	.about-shortcuts {
		display: inline-flex;
		gap: 7px;
		align-items: center;
	}

	.about-shortcuts {
		gap: 14px;
	}

	.about-shortcuts > span {
		width: 1px;
		height: 20px;
		background: var(--line-strong);
	}

	.about-shortcuts a {
		display: grid;
		width: 24px;
		height: 24px;
		place-items: center;
	}

	.about-shortcuts a:hover,
	.about-shortcuts a:focus-visible {
		background: var(--accent-yellow);
		outline: 1px dashed var(--ink);
		outline-offset: 1px;
	}

	.shortcut-icon {
		position: relative;
		display: block;
		width: 18px;
		height: 16px;
	}

	.shortcut-icon--github {
		border: 1px solid var(--ink);
		border-radius: 50%;
		background: var(--ink);
	}

	.shortcut-icon--github::after {
		position: absolute;
		right: 4px;
		bottom: -3px;
		width: 4px;
		height: 6px;
		background: var(--ink);
		content: "";
	}

	.shortcut-icon--folder {
		margin-top: 3px;
		border: 1px solid var(--ink);
		background: var(--accent-yellow);
	}

	.shortcut-icon--folder::before {
		position: absolute;
		top: -4px;
		left: -1px;
		width: 8px;
		height: 4px;
		border: 1px solid var(--ink);
		border-bottom: 0;
		background: var(--accent-yellow);
		content: "";
	}

	.shortcut-icon--mail {
		border: 1px solid var(--ink);
		background: var(--paper);
	}

	.shortcut-icon--mail::before,
	.shortcut-icon--mail::after {
		position: absolute;
		top: 4px;
		width: 10px;
		height: 1px;
		background: var(--ink);
		content: "";
	}

	.shortcut-icon--mail::before {
		left: 0;
		transform: rotate(30deg);
	}

	.shortcut-icon--mail::after {
		right: 0;
		transform: rotate(-30deg);
	}

	.about-status a,
	.project-toolbar a,
	.writing-footer a {
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.project-toolbar,
	.writing-toolbar,
	.writing-footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.project-toolbar {
		padding: 9px 13px;
		border-bottom: 1px solid var(--ink);
		background: var(--paper);
		font-size: 0.7rem;
		font-weight: 800;
	}

	.project-toolbar > div {
		display: inline-flex;
		gap: 9px;
		align-items: center;
	}

	.project-toolbar strong,
	.writing-toolbar strong {
		font-family: var(--font-data);
		font-size: 0.68rem;
	}

	.mini-folder {
		position: relative;
		display: block;
		width: 24px;
		height: 16px;
		margin-top: 3px;
		border: 1px solid var(--ink);
		background: var(--accent-yellow);
	}

	.mini-folder::before {
		position: absolute;
		top: -5px;
		left: -1px;
		width: 10px;
		height: 5px;
		border: 1px solid var(--ink);
		border-bottom: 0;
		background: var(--accent-yellow);
		content: "";
	}

	.project-list {
		margin: 0;
		padding: 8px;
		list-style: none;
	}

	.project-list li + li {
		border-top: 1px solid var(--line-strong);
	}

	.project-list a {
		display: grid;
		grid-template-columns: 52px minmax(0, 1fr) 28px;
		gap: 13px;
		align-items: center;
		padding: 11px 9px;
	}

	.project-list a:hover,
	.project-list a:focus-visible {
		background: var(--selection);
		color: white;
	}

	.project-icon {
		position: relative;
		display: grid;
		width: 48px;
		height: 42px;
		border: 1px solid var(--ink);
		background: var(--accent-cyan);
		box-shadow: inset -7px -7px 0 rgb(0 0 0 / 12%);
		place-items: center;
	}

	.project-icon::before,
	.project-icon::after,
	.project-icon i {
		position: absolute;
		background: var(--ink);
		content: "";
	}

	.project-icon::before {
		width: 19px;
		height: 3px;
		transform: rotate(45deg);
	}

	.project-icon::after {
		width: 19px;
		height: 3px;
		transform: rotate(-45deg);
	}

	.project-icon i {
		width: 3px;
		height: 25px;
	}

	.project-icon--yellow {
		background: var(--accent-yellow);
	}

	.project-icon--coral {
		background: var(--accent-coral);
	}

	.project-info {
		display: block;
		min-width: 0;
	}

	.project-info strong,
	.project-info small {
		display: block;
	}

	.project-info strong {
		font-size: 0.86rem;
		font-weight: 900;
	}

	.project-info small {
		overflow: hidden;
		margin-top: 3px;
		color: var(--muted);
		font-size: 0.7rem;
		line-height: 1.45;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.project-list a:hover small,
	.project-list a:focus-visible small {
		color: #eefcff;
	}

	.project-actions {
		display: inline-flex;
		gap: 8px;
		align-items: center;
		justify-content: flex-end;
	}

	.project-actions i,
	.project-actions em {
		font-size: 0.95rem;
		font-style: normal;
		font-weight: 900;
	}

	.project-actions b {
		position: relative;
		display: block;
		width: 12px;
		height: 15px;
		border: 1px solid currentColor;
	}

	.project-actions b::before,
	.project-actions b::after {
		position: absolute;
		right: 2px;
		left: 2px;
		height: 1px;
		background: currentColor;
		content: "";
	}

	.project-actions b::before {
		top: 4px;
	}

	.project-actions b::after {
		top: 8px;
	}

	.writing-toolbar {
		padding: 9px 13px;
		border-bottom: 1px solid var(--ink);
		background: var(--paper);
		font-size: 0.72rem;
		font-weight: 800;
	}

	.writing-toolbar > div {
		display: inline-flex;
		gap: 10px;
		align-items: center;
	}

	.mini-document {
		position: relative;
		display: block;
		width: 18px;
		height: 22px;
		border: 1px solid var(--ink);
		background: var(--paper);
	}

	.mini-document::before {
		position: absolute;
		top: 5px;
		right: 3px;
		left: 3px;
		height: 1px;
		background: var(--ink);
		box-shadow: 0 4px 0 var(--ink), 0 8px 0 var(--accent-cyan);
		content: "";
	}

	.article-list {
		display: flex;
		flex-direction: column;
		flex: 1;
		background: var(--paper);
	}

	.article-row--featured:only-child {
		display: flex;
		flex: 1;
	}

	.article-row--featured:only-child a {
		flex: 1;
	}

	#writing,
	#writing .mac-window-body {
		display: flex;
		flex-direction: column;
	}

	#writing .mac-window-content {
		flex: 1;
		min-height: 0;
	}

	#writing .mac-window-body {
		flex: 1;
	}

	.article-row + .article-row {
		border-top: 1px solid var(--line-strong);
	}

	.article-row a {
		display: grid;
		grid-template-columns: 70px minmax(0, 1fr) 104px 52px;
		gap: 14px;
		align-items: center;
		padding: 15px;
		transition: background 120ms ease, color 120ms ease;
	}

	.article-row--featured a {
		min-height: 238px;
		background: var(--paper);
		color: var(--ink);
	}

	.article-row--featured .article-copy strong {
		font-size: clamp(1.25rem, 2.4vw, 1.75rem);
	}

	.article-row--featured .article-copy small {
		display: -webkit-box;
		overflow: hidden;
		max-width: 68ch;
		font-size: 0.8rem;
		line-height: 1.7;
		white-space: normal;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 3;
	}

	.article-row a:hover,
	.article-row a:focus-visible {
		background: var(--selection);
		color: white;
		outline: none;
	}

	.article-index {
		display: block;
		margin-bottom: 6px;
		color: var(--accent-blue-dark);
		font-family: var(--font-data);
		font-size: 0.64rem;
		font-weight: 900;
	}

	.article-file-icon {
		position: relative;
		display: block;
		width: 68px;
		height: 54px;
		border: 1px solid var(--ink);
		background:
			radial-gradient(var(--line-strong) 0.7px, transparent 0.7px),
			var(--accent-cyan);
		background-size: 3px 3px;
	}

	.article-file-icon i {
		position: absolute;
		top: 11px;
		left: 21px;
		width: 25px;
		height: 32px;
		border: 1px solid var(--ink);
		background: var(--paper);
	}

	.article-file-icon i::before {
		position: absolute;
		top: 8px;
		right: 4px;
		left: 4px;
		height: 2px;
		background: var(--ink);
		box-shadow: 0 6px 0 var(--ink), 0 12px 0 var(--accent-coral);
		content: "";
	}

	.article-copy,
	.article-copy strong,
	.article-copy small,
	.article-meta,
	.article-meta small {
		display: block;
		min-width: 0;
	}

	.article-copy strong {
		font-size: clamp(0.92rem, 1.8vw, 1.13rem);
		font-weight: 900;
		line-height: 1.35;
	}

	.article-copy small {
		overflow: hidden;
		margin-top: 5px;
		color: var(--muted);
		font-size: 0.72rem;
		line-height: 1.5;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.article-row a:hover .article-copy small,
	.article-row a:focus-visible .article-copy small,
	.article-row a:hover .article-meta,
	.article-row a:focus-visible .article-meta,
	.article-row a:hover .article-index,
	.article-row a:focus-visible .article-index {
		color: white;
	}

	.article-meta {
		color: var(--muted);
		font-size: 0.66rem;
		line-height: 1.5;
		text-align: right;
	}

	.article-meta small {
		margin-top: 3px;
	}

	.article-open {
		padding: 7px 9px;
		border: 1px dashed currentColor;
		font-family: var(--font-data);
		font-size: 0.64rem;
		font-weight: 900;
		text-align: center;
	}

	.writing-footer {
		padding: 11px 15px;
		border-top: 1px solid var(--ink);
		background: var(--paper-soft);
		color: var(--muted);
		font-size: 0.68rem;
		font-weight: 700;
	}

	.writing-footer a {
		color: var(--ink);
	}

	.empty-state {
		display: flex;
		align-items: center;
		justify-content: space-between;
		min-height: 160px;
		padding: 28px;
	}

	@media (min-width: 1024px) {
		.desktop-icons {
			position: absolute;
			top: 48%;
			left: 3%;
			display: grid;
			z-index: 10;
			gap: 24px;
		}

		.desktop-icons a {
			display: grid;
			gap: 6px;
			justify-items: center;
			width: 68px;
			color: white;
			font-size: 0.68rem;
			font-weight: 800;
			text-shadow: 1px 1px 0 var(--ink);
		}

		.desktop-icons a:focus-visible {
			background: var(--selection);
		}

		.desktop-icon {
			position: relative;
			display: block;
			width: 48px;
			height: 42px;
			border: 1px solid var(--ink);
			background: var(--paper);
			box-shadow: 3px 4px 0 rgb(21 23 29 / 28%);
		}

		.desktop-icon--computer::before {
			position: absolute;
			inset: 6px 6px 11px;
			border: 2px solid var(--ink);
			background: var(--accent-cyan);
			content: "";
		}

		.desktop-icon--computer::after {
			position: absolute;
			bottom: 4px;
			left: 15px;
			width: 16px;
			height: 3px;
			background: var(--ink);
			content: "";
		}

		.desktop-icon--document::before {
			position: absolute;
			inset: 7px 9px;
			border: 2px solid var(--ink);
			background: var(--accent-yellow);
