---
import ArchivePage from '../../../components/ArchivePage.astro';
import { getArchivePage, getArchivePageCount } from '../../../lib/blog';
import { getBlogPosts, type BlogPost } from '../../../lib/github';

export async function getStaticPaths() {
	const posts = await getBlogPosts();
	const totalPages = getArchivePageCount(posts.length);

	return Array.from({ length: Math.max(0, totalPages - 1) }, (_, index) => {
		const currentPage = index + 2;

		return {
			params: { page: String(currentPage) },
			props: {
				posts: getArchivePage(posts, currentPage),
				totalPosts: posts.length,
				currentPage,
				totalPages,
			},
		};
	});
}

interface Props {
	posts: BlogPost[];
	totalPosts: number;
	currentPage: number;
	totalPages: number;
}

const { posts, totalPosts, currentPage, totalPages } = Astro.props;
---

<ArchivePage
	posts={posts}
	totalPosts={totalPosts}
	currentPage={currentPage}
	totalPages={totalPages}
	locale="en"
/>
